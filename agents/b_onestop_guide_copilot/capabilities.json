{
  "runtime_spec_version": "anp-agent/v1.2",
  "trust_level": "platform",
  "source_type": "builtin",
  "auth_mode": "trusted_gateway",
  "tenant_id": "sd-default",
  "context_policy": "regulated_minimal",
  "scenario_class": "B",
  "quick_questions": [
    "这个助手适合帮政务服务导办人员处理什么问题？",
    "我应该提供哪些编号、时间范围或判断条件？",
    "请围绕“基于事项和材料共享目录，输出一次办导办路径与所需数据说明。”给出一份只读研判摘要。"
  ],
  "runtime_ready": true,
  "net_new": "none",
  "capability_tools": [
    {
      "skill_id": "search.intent.parse",
      "name": "search_intent_parse",
      "description": "P2 资源发现页减摩组件。把用户一句话搜索拆成结构化辅助字段：业务意图、关键词、覆盖范围、缺口字段、推荐理由、追问列表。仅作辅助提示，不替代目录树 / 筛选器 / 资源详情。zw-brain 主进程不持有推理平台 SDK/env，当前走本地确定性规则。可由调用方传 enabled=false 标记关闭。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "用户一句话搜索语句"
          },
          "role": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "description": "false 时跳过推理直接走本地规则；默认 true"
          },
          "request_id": {
            "type": "string",
            "description": "审计关联（D4）；缺省由 cap 自动生成"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "skill_id": "data.search",
      "name": "data_search",
      "description": "按关键词 / 部门 / 主题域检索共享数据资源目录，返回命中清单与结构化摘要。",
      "input_schema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          }
        }
      }
    },
    {
      "skill_id": "catalog.browse",
      "name": "catalog_browse",
      "description": "按 lifecycle / kind / owner / 关键词分页浏览 canonical catalog_entry。默认过滤 retired 噪声和 api-group 节点，给 WebUI 提供客户级浏览入口。",
      "input_schema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "lifecycle": {
            "type": "string",
            "enum": [
              "active",
              "approved_pending_publish",
              "draft",
              "pending_review",
              "rejected",
              "all"
            ],
            "default": "active"
          },
          "kind": {
            "type": "string",
            "enum": [
              "real",
              "api-group",
              "all"
            ],
            "default": "real"
          },
          "owner_org_id": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    {
      "skill_id": "catalog.entry.query",
      "name": "catalog_entry_query",
      "description": "查询已进入 canonical 聚合的目录条目详情和列表。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "catalog_code": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "filter by summary_json.source (e.g. 'reverse' for 反向编目 drafts)"
          },
          "lifecycle_status": {
            "type": "string",
            "description": "filter by lifecycle_status (draft / pending_review / active / ...)"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "max rows to return; filters apply in SQL before serialization"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "skip rows before applying limit"
          },
          "order": {
            "type": "string",
            "enum": [
              "updated_desc"
            ],
            "description": "result ordering: 'updated_desc' = newest updated first (work-queue view); default = catalog_code ascending (stable browse order)"
          },
          "role": {
            "type": "string"
          }
        }
      }
    }
  ]
}
