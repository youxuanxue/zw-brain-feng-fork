{
  "runtime_spec_version": "anp-agent/v1.2",
  "trust_level": "platform",
  "source_type": "builtin",
  "auth_mode": "trusted_gateway",
  "tenant_id": "sd-default",
  "context_policy": "regulated_minimal",
  "capability_tools": [
    {
      "skill_id": "data.search",
      "name": "data_search",
      "description": "按关键词检索已编目共享数据资源（含法人库群体画像目录、行业基准目录），只读。",
      "input_schema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "minLength": 1 },
          "page": { "type": "integer", "minimum": 1, "default": 1 }
        }
      }
    },
    {
      "skill_id": "catalog.entry.query",
      "name": "catalog_entry_query",
      "description": "查询已编目目录条目（企业登记 / 法人画像类目录条目），只读。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "catalog_code": { "type": "string" },
          "lifecycle_status": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1 },
          "offset": { "type": "integer", "minimum": 0 }
        }
      }
    },
    {
      "skill_id": "metadata.catalog_item.query",
      "name": "catalog_item_query",
      "description": "查询目录项字段映射（失信 / 黑名单 / 经营异常 / 纳税信用等级 / 参保数 / 注册资本等只读标签），只读。",
      "input_schema": {
        "type": "object",
        "properties": {
          "resource_code": { "type": "string" },
          "catalog_code": { "type": "string" }
        }
      }
    }
  ]
}
