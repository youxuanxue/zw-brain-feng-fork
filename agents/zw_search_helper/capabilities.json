{
  "runtime_spec_version": "anp-agent/v1.2",
  "trust_level": "platform",
  "source_type": "builtin",
  "auth_mode": "trusted_gateway",
  "tenant_id": "sd-default",
  "context_policy": "regulated_minimal",
  "capability_tools": [
    {
      "skill_id": "search.intent.parse",
      "name": "search_intent_parse",
      "description": "P2 搜索意图解析：自然语言 → 结构化检索辅助字段（只读，走统一推理或规则回落）。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "用户一句话搜索" },
          "enabled": { "type": "boolean" }
        },
        "required": ["query"]
      }
    },
    {
      "skill_id": "data.search",
      "name": "data_search",
      "description": "按关键词检索共享数据资源目录，返回命中清单与结构化摘要（只读）。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "minLength": 1 },
          "page": { "type": "integer", "minimum": 1, "default": 1 }
        },
        "required": ["query"]
      }
    },
    {
      "skill_id": "catalog.browse",
      "name": "catalog_browse",
      "description": "按 lifecycle / kind / owner / 关键词分页浏览 canonical 真目录条目（只读，默认过滤 retired 与 api-group 节点）。",
      "input_schema": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "minimum": 1, "default": 1 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
          "lifecycle": {
            "type": "string",
            "enum": ["active", "approved_pending_publish", "draft", "pending_review", "rejected", "all"],
            "default": "active"
          },
          "kind": {
            "type": "string",
            "enum": ["real", "api-group", "all"],
            "default": "real"
          },
          "owner_org_id": { "type": "string" },
          "query": { "type": "string" }
        }
      }
    },
    {
      "skill_id": "catalog.entry.query",
      "name": "catalog_entry_query",
      "description": "查询已进入 canonical 聚合的目录条目详情与列表，用于术语对齐与口径核对（只读）。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "catalog_code": { "type": "string" },
          "source": { "type": "string", "description": "filter by summary_json.source (e.g. 'reverse')" },
          "lifecycle_status": { "type": "string", "description": "draft / pending_review / active / ..." },
          "limit": { "type": "integer", "minimum": 1 },
          "offset": { "type": "integer", "minimum": 0 },
          "order": {
            "type": "string",
            "enum": ["updated_desc"],
            "description": "updated_desc = newest first; 缺省按 catalog_code 升序"
          }
        }
      }
    }
  ]
}
