{
  "runtime_spec_version": "anp-agent/v1.2",
  "trust_level": "platform",
  "source_type": "builtin",
  "auth_mode": "trusted_gateway",
  "tenant_id": "sd-default",
  "context_policy": "regulated_minimal",
  "scenario_class": "A",
  "quick_questions": [
    "我是新客户，请按业务流程介绍系统怎么用？",
    "帮我找一类数据，并说明能不能申请。",
    "我有申请或交付编号，帮我看现在卡在哪一步。"
  ],
  "runtime_ready": true,
  "net_new": "none",
  "capability_tools": [
    {
      "skill_id": "platform.docs.search",
      "name": "platform_docs_search",
      "description": "在 zw-brain 仓库 docs/ 等只读文档中按关键词检索，返回路径、标题与摘要片段，供平台问答 Agent 定位资料。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "检索关键词或短语"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 8
          },
          "role": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "skill_id": "platform.docs.read",
      "name": "platform_docs_read",
      "description": "按相对路径读取 zw-brain 仓库内已授权 Markdown 文档正文（只读，带长度上限），供平台问答 Agent 核对细节。",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "文档相对路径，如 deployment/docker-image-deployment.md"
          },
          "rel_path": {
            "type": "string",
            "description": "同 path 的别名"
          },
          "max_chars": {
            "type": "integer",
            "minimum": 500,
            "maximum": 24000
          },
          "role": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "skill_id": "search.intent.parse",
      "name": "search_intent_parse",
      "description": "P2 资源发现页减摩组件。把用户一句话搜索拆成结构化辅助字段：业务意图、关键词、覆盖范围、缺口字段、推荐理由、追问列表。仅作辅助提示，不替代目录树 / 筛选器 / 资源详情。zw-brain 主进程不持有推理平台 SDK/env，当前走本地确定性规则。可由调用方传 enabled=false 标记关闭。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "用户一句话搜索语句"
          },
          "role": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "description": "false 时跳过推理直接走本地规则；默认 true"
          },
          "request_id": {
            "type": "string",
            "description": "审计关联（D4）；缺省由 cap 自动生成"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "skill_id": "data.search",
      "name": "data_search",
      "description": "按关键词 / 部门 / 主题域检索共享数据资源目录，返回命中清单与结构化摘要。",
      "input_schema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          }
        }
      }
    },
    {
      "skill_id": "catalog.browse",
      "name": "catalog_browse",
      "description": "按 lifecycle / kind / owner / 关键词分页浏览 canonical catalog_entry。默认过滤 retired 噪声和 api-group 节点，给 WebUI 提供客户级浏览入口。",
      "input_schema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "lifecycle": {
            "type": "string",
            "enum": [
              "active",
              "approved_pending_publish",
              "draft",
              "pending_review",
              "rejected",
              "all"
            ],
            "default": "active"
          },
          "kind": {
            "type": "string",
            "enum": [
              "real",
              "api-group",
              "all"
            ],
            "default": "real"
          },
          "owner_org_id": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    {
      "skill_id": "catalog.entry.query",
      "name": "catalog_entry_query",
      "description": "查询已进入 canonical 聚合的目录条目详情和列表。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "catalog_code": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "filter by summary_json.source (e.g. 'reverse' for 反向编目 drafts)"
          },
          "lifecycle_status": {
            "type": "string",
            "description": "filter by lifecycle_status (draft / pending_review / active / ...)"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "max rows to return; filters apply in SQL before serialization"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "skip rows before applying limit"
          },
          "order": {
            "type": "string",
            "enum": [
              "updated_desc"
            ],
            "description": "result ordering: 'updated_desc' = newest updated first (work-queue view); default = catalog_code ascending (stable browse order)"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
