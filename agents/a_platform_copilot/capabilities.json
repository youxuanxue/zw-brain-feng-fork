    {
      "skill_id": "audit.event.query",
      "name": "audit_event_query",
      "description": "按 actor / skill_id / tenant_id / audit_class / 时间窗口查询正规化后的审计事件流。回包含事件元数据 + 聚合摘要，不外泄 payload 原文（payload 字段需通过专用 evidence chain 二次申请）。",
      "input_schema": {
        "type": "object",
        "properties": {
          "actor": {
            "type": "string",
            "description": "按发起人精确匹配，如 'user:gov:ROLE_SECURITY_AUDIT:安全审计员'"
          },
          "skill_id": {
            "type": "string",
            "description": "按 capability skill_id 精确匹配"
          },
          "tenant_id": {
            "type": "string",
            "description": "租户 ID；缺省走运行时租户（sd-default 单租户模式下不可跨租户读）"
          },
          "audit_class": {
            "type": "string",
            "enum": [
              "write-critical",
              "write-normal",
              "read-sensitive"
            ],
            "description": "按 3 级正规化 audit_class 过滤；其他历史值在 store 写入时已 normalize"
          },
          "since": {
            "type": "string",
            "format": "date-time",
            "description": "起始时间（ISO8601 含时区）"
          },
          "until": {
            "type": "string",
            "format": "date-time",
            "description": "截止时间（ISO8601 含时区）"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 200
          }
        }
      }
    },
    {
      "skill_id": "audit.event.statistics",
      "name": "audit_event_statistics",
      "description": "按时间桶（hour / day / week / month）+ 维度（actor / skill_id / tenant_id / audit_class）聚合审计事件计数；用于 B1.1 合规与运营面统计 panel。只读，单租户 sd-default 强过滤。",
      "input_schema": {
        "type": "object",
        "properties": {
          "bucket": {
            "type": "string",
            "enum": [
              "hour",
              "day",
              "week",
              "month"
            ],
            "default": "day",
            "description": "时间桶粒度"
          },
          "dimension": {
            "type": "string",
            "enum": [
              "actor",
              "skill_id",
              "audit_class",
              "tenant_id"
            ],
            "default": "audit_class",
            "description": "聚合维度"
          },
          "tenant_id": {
            "type": "string",
            "description": "租户 ID；缺省走运行时租户（单租户 sd-default 模式下不可跨租户读）"
          },
          "since": {
            "type": "string",
            "format": "date-time"
          },
          "until": {
            "type": "string",
            "format": "date-time"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 1000
          }
        }
      }
    },
    {
      "skill_id": "audit.event.anomaly",
      "name": "audit_event_anomaly",
      "description": "Rule-based 异常事件 Top-N 扫描，三类内建规则：(1) 跨租户读 cross-tenant-read；(2) 单 actor 高频失败 high-failure-rate；(3) 反复 denied request_id repeated-denied。返回每条异常的证据 request_id + 命中规则；不返回原始 payload 全文。用于 B1.1 异常 + 督查 panel。",
      "input_schema": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string"
          },
          "since": {
            "type": "string",
            "format": "date-time"
          },
          "until": {
            "type": "string",
            "format": "date-time"
          },
          "top_n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "min_failure_count": {
            "type": "integer",
            "minimum": 2,
            "default": 3,
            "description": "high-failure-rate 规则的最低失败次数阈值"
          }
        }
      }
    },
    {
      "skill_id": "audit.event.accountability",
      "name": "audit_event_accountability",
      "description": "按 actor 反查所有 outcome=denied 的 request_id + 关联完整 audit 链；用于 B1.1 追责 panel。返回链路 metadata + sanitized payload（敏感字段 hash 化）；不返回原始 payload 全文。",
      "input_schema": {
        "type": "object",
