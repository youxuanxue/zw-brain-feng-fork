{
  "runtime_spec_version": "anp-agent/v1.2",
  "trust_level": "platform",
  "source_type": "builtin",
  "auth_mode": "trusted_gateway",
  "tenant_id": "sd-default",
  "context_policy": "regulated_minimal",
  "scenario_class": "A",
  "quick_questions": [
    "这个助手适合帮申请受理与审核人员处理什么问题？",
    "我应该提供哪些编号、时间范围或判断条件？",
    "请围绕“汇总审批详情、申请详情和审批依据摘要，输出只读研判要点。”给出一份只读研判摘要。"
  ],
  "runtime_ready": true,
  "net_new": "none",
  "capability_tools": [
    {
      "skill_id": "approval.view",
      "name": "approval_view",
      "description": "查看审批建议、风险、影响和异常项。",
      "input_schema": {
        "type": "object",
        "required": [
          "request_id"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "skill_id": "request.view",
      "name": "request_view",
      "description": "查看申请详情、差异字段、时间线与 AI 解释。",
      "input_schema": {
        "type": "object",
        "required": [
          "request_id"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "skill_id": "approval.evidence.summarize",
      "name": "approval_evidence_summarize",
      "description": "P3 审批页减摩组件。输入待审申请 id，归纳支持依据 / 反事实因素 / 推荐审批结论 (approve|return_for_fix|reject)。仅作辅助提示，绝不调用审批决策接口。zw-brain 主进程不持有推理平台 SDK/env，当前走本地确定性规则。",
      "input_schema": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "application_id"
        ]
      }
    },
    {
      "skill_id": "catalog.entry.query",
      "name": "catalog_entry_query",
      "description": "查询已进入 canonical 聚合的目录条目详情和列表。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "catalog_code": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "filter by summary_json.source (e.g. 'reverse' for 反向编目 drafts)"
          },
          "lifecycle_status": {
            "type": "string",
            "description": "filter by lifecycle_status (draft / pending_review / active / ...)"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "max rows to return; filters apply in SQL before serialization"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "skip rows before applying limit"
          },
          "order": {
            "type": "string",
            "enum": [
              "updated_desc"
            ],
            "description": "result ordering: 'updated_desc' = newest updated first (work-queue view); default = catalog_code ascending (stable browse order)"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    {
      "skill_id": "delivery.view",
      "name": "delivery_view",
      "description": "查看预填下发、自动汇总和回流候选的交付任务详情。",
      "input_schema": {
        "type": "object",
        "required": [
          "task_id"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
