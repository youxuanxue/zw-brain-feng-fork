{
  "runtime_spec_version": "anp-agent/v1.2",
  "trust_level": "platform",
  "source_type": "builtin",
  "auth_mode": "trusted_gateway",
  "tenant_id": "sd-default",
  "context_policy": "regulated_minimal",
  "scenario_class": "B",
  "quick_questions": [
    "这个助手适合帮交通工程数据对账人员处理什么问题？",
    "我应该提供哪些编号、时间范围或判断条件？",
    "请围绕“检索市政交通工程竣工验收目录、交付与交换统计，形成对账摘要。”给出一份只读研判摘要。"
  ],
  "runtime_ready": true,
  "net_new": "none",
  "capability_tools": [
    {
      "skill_id": "data.search",
      "name": "data_search",
      "description": "按关键词 / 部门 / 主题域检索共享数据资源目录，返回命中清单与结构化摘要。",
      "input_schema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          }
        }
      }
    },
    {
      "skill_id": "catalog.entry.query",
      "name": "catalog_entry_query",
      "description": "查询已进入 canonical 聚合的目录条目详情和列表。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "catalog_code": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "filter by summary_json.source (e.g. 'reverse' for 反向编目 drafts)"
          },
          "lifecycle_status": {
            "type": "string",
            "description": "filter by lifecycle_status (draft / pending_review / active / ...)"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "max rows to return; filters apply in SQL before serialization"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "skip rows before applying limit"
          },
          "order": {
            "type": "string",
            "enum": [
              "updated_desc"
            ],
            "description": "result ordering: 'updated_desc' = newest updated first (work-queue view); default = catalog_code ascending (stable browse order)"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    {
      "skill_id": "delivery.list",
      "name": "delivery_list",
      "description": "查看预填下发、自动汇总、回流候选和异常交付任务列表。",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "skill_id": "delivery.view",
      "name": "delivery_view",
      "description": "查看预填下发、自动汇总和回流候选的交付任务详情。",
      "input_schema": {
        "type": "object",
        "required": [
          "task_id"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "skill_id": "ops.exchange.statistics.query",
      "name": "ops_exchange_statistics_query",
      "description": "只读查询交换、订阅和交付投影统计，不反向驱动业务状态。",
      "input_schema": {
        "type": "object",
        "properties": {
          "resource_code": {
            "type": "string"
          },
          "delivery_code": {
            "type": "string"
          },
          "metric_scope": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": []
      }
    }
  ]
}
