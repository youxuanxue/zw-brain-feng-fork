{
  "runtime_spec_version": "anp-agent/v1.2",
  "trust_level": "platform",
  "source_type": "builtin",
  "auth_mode": "trusted_gateway",
  "tenant_id": "sd-default",
  "context_policy": "regulated_minimal",
  "scenario_class": "A",
  "quick_questions": [
    "这个助手适合帮供需对接人员处理什么问题？",
    "我应该提供哪些编号、时间范围或判断条件？",
    "请围绕“根据需求列表、意图解析和资源检索结果，给出可复用目录或人工登记建议。”给出一份只读研判摘要。"
  ],
  "runtime_ready": true,
  "net_new": "none",
  "capability_tools": [
    {
      "skill_id": "demand.list",
      "name": "demand_list",
      "description": "列出当前租户登记的 demand 记录，可按 phase 筛选。",
      "input_schema": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          }
        }
      }
    },
    {
      "skill_id": "search.intent.parse",
      "name": "search_intent_parse",
      "description": "P2 资源发现页减摩组件。把用户一句话搜索拆成结构化辅助字段：业务意图、关键词、覆盖范围、缺口字段、推荐理由、追问列表。仅作辅助提示，不替代目录树 / 筛选器 / 资源详情。zw-brain 主进程不持有推理平台 SDK/env，当前走本地确定性规则。可由调用方传 enabled=false 标记关闭。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "用户一句话搜索语句"
          },
          "role": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "description": "false 时跳过推理直接走本地规则；默认 true"
          },
          "request_id": {
            "type": "string",
            "description": "审计关联（D4）；缺省由 cap 自动生成"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "skill_id": "data.search",
      "name": "data_search",
      "description": "按关键词 / 部门 / 主题域检索共享数据资源目录，返回命中清单与结构化摘要。",
      "input_schema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          }
        }
      }
    },
    {
      "skill_id": "recommendation.similar_catalog.suggest",
      "name": "recommendation_similar_catalog_suggest",
      "description": "J1 申请前置：基于已入库 live 推荐规则 + 历史申请投影，按意向文本推荐相似目录候选。推荐为空且 fallback_register=true 时落 manual_requirement 转人工登记。",
      "input_schema": {
        "type": "object",
        "required": [
          "tenant_id",
          "intent_text",
          "submitted_by"
        ],
        "properties": {
          "tenant_id": {
            "type": "string"
          },
          "intent_text": {
            "type": "string"
          },
          "intent_org": {
            "type": "string"
          },
          "top_k": {
            "type": "integer"
          },
          "submitted_by": {
            "type": "string"
          },
          "fallback_register": {
            "type": "boolean"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    {
      "skill_id": "catalog.entry.query",
      "name": "catalog_entry_query",
      "description": "查询已进入 canonical 聚合的目录条目详情和列表。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "catalog_code": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "filter by summary_json.source (e.g. 'reverse' for 反向编目 drafts)"
          },
          "lifecycle_status": {
            "type": "string",
            "description": "filter by lifecycle_status (draft / pending_review / active / ...)"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "max rows to return; filters apply in SQL before serialization"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "skip rows before applying limit"
          },
          "order": {
            "type": "string",
            "enum": [
              "updated_desc"
            ],
            "description": "result ordering: 'updated_desc' = newest updated first (work-queue view); default = catalog_code ascending (stable browse order)"
          },
          "role": {
            "type": "string"
          }
        }
      }
    }
  ]
}
