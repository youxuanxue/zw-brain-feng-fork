{
  "runtime_spec_version": "anp-agent/v1.2",
  "trust_level": "platform",
  "source_type": "builtin",
  "auth_mode": "trusted_gateway",
  "tenant_id": "sd-default",
  "context_policy": "regulated_minimal",
  "scenario_class": "A",
  "quick_questions": [
    "我是新客户，请按业务流程介绍系统怎么用？",
    "各角色在流程中的位置和操作分别是什么？",
    "申请共享数据从找数到交付怎么走？"
  ],
  "runtime_ready": true,
  "net_new": "none",
  "capability_tools": [
    {
      "skill_id": "platform.docs.search",
      "name": "platform_docs_search",
      "description": "在 zw-brain 仓库 docs/ 等只读文档中按关键词检索，返回路径、标题与摘要片段，供平台问答 Agent 定位资料。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "检索关键词或短语"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 8
          },
          "role": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "skill_id": "platform.docs.read",
      "name": "platform_docs_read",
      "description": "按相对路径读取 zw-brain 仓库内已授权 Markdown 文档正文（只读，带长度上限），供平台问答 Agent 核对细节。",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "文档相对路径，如 deployment/docker-image-deployment.md"
          },
          "rel_path": {
            "type": "string",
            "description": "同 path 的别名"
          },
          "max_chars": {
            "type": "integer",
            "minimum": 500,
            "maximum": 24000
          },
          "role": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  ]
}
