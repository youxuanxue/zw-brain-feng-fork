{
  "runtime_spec_version": "anp-agent/v1.2",
  "trust_level": "platform",
  "source_type": "builtin",
  "auth_mode": "trusted_gateway",
  "tenant_id": "sd-default",
  "context_policy": "regulated_minimal",
  "capability_tools": [
    {
      "skill_id": "platform.docs.search",
      "name": "platform_docs_search",
      "description": "在 zw-brain 项目文档中按关键词检索，返回路径、标题与摘要。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "检索词" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 20 }
        },
        "required": ["query"]
      }
    },
    {
      "skill_id": "platform.docs.read",
      "name": "platform_docs_read",
      "description": "读取指定相对路径的 Markdown 文档正文（只读）。",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "如 deployment/docker-image-deployment.md" },
          "max_chars": { "type": "integer" }
        },
        "required": ["path"]
      }
    }
  ]
}
