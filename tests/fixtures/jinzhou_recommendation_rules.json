            "clause_code": "cat_finance",
            "clause_kind": "category_match",
            "clause_payload_json": {
              "categories": ["预算", "财政", "基金"],
              "catalog_category_hint": "政府性基金预算支出预算表"
            },
            "weight": 1.2,
            "order_index": 0
          }
        ]
      }
    },
    {
      "rule_code": "jz_org_affinity_v1",
      "title": "荆州·机构关联度",
