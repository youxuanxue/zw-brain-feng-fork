{
  "_meta": {
    "source": "F6 supervisor instruction — 荆州 5 条推荐规则示例",
    "purpose": "覆盖 5 种主要 clause_kind（keyword_match / category_match / org_affinity / usage_frequency / fuzzy_text）各 1 条；第 5 条同时叠 fuzzy_text",
    "tenant_id": "sd-default"
  },
  "rules": [
    {
      "rule_code": "jz_disabled_keyword_v1",
      "title": "荆州·残疾人信息直接命中",
      "payload": {
