# zw-brain 外部环境变量模板
# ─────────────────────────────────────────────────────────────────────────────
# 用法：cp .env.example .env  →  填真实值  →  bash scripts/start-local.sh（自动 source .env）
# .env 已被 .gitignore 忽略（密钥不进版本库）；本模板只放占位/地址，禁写真密钥。
#
# 格式铁律：注释只占独立行（# 开头）；KEY=VALUE 行**不写行内注释**——
#   值里带 ` # ...` 会被当成 URL fragment / 控制字符导致连接失败（2026-05-29 实测踩过）。
#   loader 已防御性剥行内注释，但模板仍坚持"值行纯净"避免歧义。
# 密钥约定（D36.a）：明文用 *_API_KEY / *_CLIENT_SECRET；引用指针用 *_REF（arn:/vault:），
#   部署层解析 _REF → 注入字面值。本机 dev 可填字面；生产走 _REF。
# 标注见每个变量上方注释：[必填-生产] / [dev] / [可选]。
# ─────────────────────────────────────────────────────────────────────────────

# ── 部署模式 ──────────────────────────────────────────────────────────────────
# 留空=dev/演示（start-local 用）；prod/production 会强制要求 Redis 会话
ZW_BRAIN_DEPLOY_MODE=
ZW_BRAIN_TENANT_ID=sd-default

# ── 集团推理平台网关（D6/D14：所有 LLM/Embedding/ASR/Rerank/OCR 唯一入口）────────
# 模式：mock=本机无网关跑假推理；platform=接真网关（默认 platform）
ZW_BRAIN_INFERENCE_MODE=platform
# [必填-生产] OpenAI 兼容网关 base_url，**须含版本前缀**（如 /v1；个别网关版本段不同）；
# client 只追加 /chat/completions 与 /embeddings —— 勿在末尾再带 /chat/completions，勿漏版本前缀（漏=404）
ZW_BRAIN_INFERENCE_GATEWAY_URL=https://<集团推理网关host>/<版本前缀，如 v1>
# [必填-生产] 集团网关上的 chat 模型名
ZW_BRAIN_INFERENCE_MODEL=<chat 模型名>
# [可选] embedding 模型名（≠ chat 模型）。zw-brain 目前未启用 embeddings；
#   将来上语义检索/RAG 时填独立 embedding 模型并由调用方传入（embed(model=...)）。
# ZW_BRAIN_INFERENCE_EMBEDDING_MODEL=<embedding 模型名>
# [dev] 字面 Bearer Key（生产改用下面的 _REF 指针，注释掉本行）
ZW_BRAIN_INFERENCE_API_KEY=<网关密钥>
# [必填-生产] 密钥引用指针（解开注释，删掉上面的明文 _API_KEY）
# ZW_BRAIN_INFERENCE_API_KEY_REF=arn:secrets:...
# [可选] 网关不校验 Bearer 时设 1
# ZW_BRAIN_INFERENCE_API_KEY_OPTIONAL=1

# ── 集团 IAM / IAF（OIDC 认证）────────────────────────────────────────────────
# [必填-生产] IAF/OIDC 认证服务地址
ZW_BRAIN_IAF_AUTH_SERVER_URL=https://<IAF认证服务host>/auth
ZW_BRAIN_IAF_REALM=<realm>
ZW_BRAIN_IAF_CLIENT_ID=<client-id>
# [dev] 字面 secret；生产改用下面的 _REF
ZW_BRAIN_IAF_CLIENT_SECRET=<client-secret>
# [必填-生产] secret 引用指针
# ZW_BRAIN_IAF_CLIENT_SECRET_REF=vault:...
# [可选] 内部 CA bundle 路径
# ZW_BRAIN_IAF_CA_FILE=/path/to/internal-ca.pem
# [可选] 仅测试/内网无证书可设 false
# ZW_BRAIN_IAF_VERIFY_SSL=true

# ── 区块链锚定（D4/D5：审计上链，可插拔 adapter）───────────────────────────────
# [可选] 缺省走 mock adapter
# ZW_BRAIN_BLOCKCHAIN_ENDPOINT=https://<链网关host>
# [可选] 上链密钥引用
# ZW_BRAIN_BLOCKCHAIN_KEY_REF=arn:secrets:...

# ── 会话（生产 / 多 REST 副本必填）────────────────────────────────────────────
# [必填-生产]
# ZW_BRAIN_SESSION_REDIS_URL=redis://redis:6379/0

# ── 数据 / DB ─────────────────────────────────────────────────────────────────
# 缺省 .data/zw_brain.db
# ZW_BRAIN_DB_PATH=/data/zw-brain/zw_brain.db
# 设了优先于 DB_PATH
# ZW_BRAIN_DATABASE_URL=

# ── REST 监听 ────────────────────────────────────────────────────────────────
# ZW_BRAIN_REST_HOST=127.0.0.1
# ZW_BRAIN_REST_PORT=8800

# ── 本机开发便利（生产禁设）──────────────────────────────────────────────────
# IAM 网络不可达时临时跳过登录；须双因子同时设置；生产部署不得出现
# ZW_BRAIN_DEV_IAM_BYPASS=1
# ZW_BRAIN_DEV_IAM_BYPASS_ACK=development-only

# ── AgentRuntime（可选，启用 /api/agent-runtime/*）────────────────────────────
# ZW_BRAIN_AGENT_RUNTIME_ENABLED=1
# ZW_BRAIN_AGENT_RUNTIME_PROFILE=embedded_single_tenant
