# zw-brain 外部环境变量模板
# ─────────────────────────────────────────────────────────────────────────────
# 用法：cp .env.example .env  →  填真实值  →  bash scripts/start-local.sh（自动 source .env）
# .env 已被 .gitignore 忽略（密钥不进版本库）；本模板只放占位/地址，禁写真密钥。
#
# 格式铁律：注释只占独立行（# 开头）；KEY=VALUE 行**不写行内注释**——
#   值里带 ` # ...` 会被当成 URL fragment / 控制字符导致连接失败（2026-05-29 实测踩过）。
#   loader 已防御性剥行内注释，但模板仍坚持"值行纯净"避免歧义。
# 密钥约定（D36.a）：明文用 *_API_KEY / *_CLIENT_SECRET；引用指针用 *_REF（arn:/vault:），
#   部署层解析 _REF → 注入字面值。本机 dev 可填字面；生产走 _REF。
# 标注见每个变量上方注释：[必填-生产] / [dev] / [可选]。
# ─────────────────────────────────────────────────────────────────────────────

# ── 部署模式 ──────────────────────────────────────────────────────────────────
# 留空=dev/演示（start-local 用）；prod/production 会强制要求 Redis 会话
ZW_BRAIN_DEPLOY_MODE=
ZW_BRAIN_TENANT_ID=sd-default

# ── 集团 IAM / IAF（OIDC 认证）────────────────────────────────────────────────
# [必填-生产] IAF/OIDC 认证服务地址
ZW_BRAIN_IAF_AUTH_SERVER_URL=https://<IAF认证服务host>/auth
ZW_BRAIN_IAF_REALM=<realm>
ZW_BRAIN_IAF_CLIENT_ID=<client-id>
# [dev] 字面 secret；生产改用下面的 _REF
ZW_BRAIN_IAF_CLIENT_SECRET=<client-secret>
# [必填-生产] secret 引用指针
# ZW_BRAIN_IAF_CLIENT_SECRET_REF=vault:...
# [可选] 内部 CA bundle 路径
# ZW_BRAIN_IAF_CA_FILE=/path/to/internal-ca.pem
# [可选] 仅测试/内网无证书可设 false；须与下面的 dev-ack 联用才生效
# ZW_BRAIN_IAF_VERIFY_SSL=true
# [可选] 关闭 IAF TLS 校验的双因子确认字；ZW_BRAIN_DEPLOY_MODE=prod 下设此=fail-closed 拒启（M5：MITM 面）
# ZW_BRAIN_IAF_INSECURE_TLS_DEV_ACK=development-only

# ── 区块链锚定（D4/D5：审计上链，可插拔 adapter）───────────────────────────────
# [可选] 缺省走 mock adapter
# ZW_BRAIN_BLOCKCHAIN_ENDPOINT=https://<链网关host>
# [可选] 上链密钥引用
# ZW_BRAIN_BLOCKCHAIN_KEY_REF=arn:secrets:...

# ── 会话（生产 / 多 REST 副本必填）────────────────────────────────────────────
# [必填-生产]
# ZW_BRAIN_SESSION_REDIS_URL=redis://redis:6379/0

# ── 数据 / DB（PostgreSQL only）────────────────────────────────────────────────
# 后端 = PostgreSQL（唯一支持后端，SQLite 已退役）。
# 默认 URL = 本地 PostgreSQL：postgresql+psycopg://zw_brain:zw_brain@127.0.0.1:5432/zw_brain
#   本地起库：docker compose up -d postgres（凭据/端口与默认 URL 对齐，无需任何 env）
#   需装驱动：pip install 'zw-brain[postgres]'
# ZW_BRAIN_DATABASE_URL = 唯一覆盖旋钮（连别的 PG / 改凭据时设整条 URL）；不设即用上面默认。
# ZW_BRAIN_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# ── REST 监听 ────────────────────────────────────────────────────────────────
# ZW_BRAIN_REST_HOST=127.0.0.1
# ZW_BRAIN_REST_PORT=8800

# ── 本机开发便利（生产禁设）──────────────────────────────────────────────────
# IAM 网络不可达时临时跳过登录；须双因子同时设置；生产部署不得出现
# ZW_BRAIN_DEV_IAM_BYPASS=1
# ZW_BRAIN_DEV_IAM_BYPASS_ACK=development-only

# ── AgentRuntime（D68 单一模型：AR 是**独立进程服务**，zw-brain 经 HTTP 驱动它）──
# 本机 start-local 可用 ZW_BRAIN_AGENT_RUNTIME_MODE=http 兼容开关“一条命令同起 AR+REST”；
# 它不是运行时形态选择。
# 容器用 docker compose（pg + agent-runtime + zw-brain 三服务）。embedded（进程内）已退役。
# 启用 /api/agent-runtime/* 看 ZW_BRAIN_AGENT_RUNTIME_ENABLED；zw-brain 驱动哪个 AR 看 ZW_BRAIN_AGENT_RUNTIME_URL。
# 本地 start-local 兼容开关：设 http 时同起独立 agent-runtime serve；不设/off 时不拉起 AR。
ZW_BRAIN_AGENT_RUNTIME_MODE=http
# 启用 /api/agent-runtime/*
ZW_BRAIN_AGENT_RUNTIME_ENABLED=1
# zw-brain -> AR 驱动地址；compose 内用 http://agent-runtime:8001
ZW_BRAIN_AGENT_RUNTIME_URL=http://127.0.0.1:8001
# start-local co-located 起 AR 的 host
ZW_BRAIN_AGENT_RUNTIME_HOST=127.0.0.1
# start-local co-located 起 AR 的 port
ZW_BRAIN_AGENT_RUNTIME_PORT=8001
# agents 目录 = **单一源**：AR 用它「跑」agent、zw-brain 用它「列」agent（数据应用页从此派生）。
# 已纳入 zw-brain git（agents/*/AGENT.yaml）；compose 把 ./agents 只读挂进两个服务保持 live 一致。
ZW_BRAIN_AGENTS_DIR=agents
# AR 内 agent 经 kind:api 工具回调 zw-brain 的地址（渲染进 A① 的 *.openapi.yaml servers）。
# 本地=zw-brain REST 自身；compose 内须用 http://zw-brain:8800。见 scripts/render-agent-specs.sh。
ZW_BRAIN_REST_BASE_URL=http://127.0.0.1:8800
# AR 部署位置：本地 = vendor 离线包装进 py312 venv（ZW_BRAIN_PYTHON_BIN 指它，start-local 自动起 serve）；
#   容器 = Dockerfile.agent-runtime + docker-compose 的 agent-runtime 服务（见 vendor/agent-runtime/README.md）。
# AR 服务侧模型配置；zw-brain REST 不读取这些变量，只在同起 AR 时由 agent-runtime 子进程消费。
OPENAI_COMPATIBLE_BASE_URL=https://<集团推理网关host>/<版本前缀，如 /api/v3>
AGENT_RUNTIME_DEFAULT_MODEL=<chat 模型名>
OPENAI_COMPATIBLE_API_KEY=<网关密钥>
# 网关不校验 Bearer 时设 1
# OPENAI_COMPATIBLE_API_KEY_OPTIONAL=1

# ── 排障日志（与审计总线分离：日志可丢、审计不可丢；详见 docs/ops/logging.md）─
# [可选] 级别 DEBUG/INFO/WARNING/ERROR，缺省 INFO
# ZW_BRAIN_LOG_LEVEL=INFO
# [可选] 控制台格式 text|json，缺省 text；文件落盘恒为 JSON lines。容器部署建议 json
# ZW_BRAIN_LOG_FORMAT=text
# [可选] 落盘目录；留空=不落盘（容器走 stdout/stderr 收集）。start-local.sh 缺省 .data/logs
# ZW_BRAIN_LOG_DIR=
# [可选] 单文件上限字节 / 轮转保留份数
# ZW_BRAIN_LOG_FILE_MAX_BYTES=10485760
# ZW_BRAIN_LOG_FILE_BACKUP_COUNT=5
# [可选] 前端错误上报端点每分钟上限（进程级）
# ZW_BRAIN_CLIENT_LOG_MAX_PER_MINUTE=60
