#!/usr/bin/env python3
"""agentruntime_doctor.py — T1 fire 时拷贝到 scripts/ 实装的命令骨架。

【SPIKE STATUS】本文件后缀 .skeleton，**不入 main scripts/，不被 preflight
拾取**，纯本地准备。

【命令契约】
    agentruntime_doctor.py <AGENT.yaml path> [--fix]
    退出码：0 = 健康；非 0 = 有诊断（diagnose & remediate suggestions on stderr）

【与 validate 的区别】
    validate.py：硬校验，pass/fail；常用于 CI 守门。
    doctor.py：软诊断 + actionable 建议，含 inference gateway / OCI registry /
        workspace volume 可达性等运行时探测；常用于本地排查、客户现场实施。

【诊断维度】
    1. spec & metadata 完整性（同 validate）
    2. inference gateway 探活：BASE_URL 可达 + auth token 有效
    3. agent_yaml_ref 解析：local file exists / OCI pull permission
    4. workspace_required=true 时检查 workspace volume mount 配置
    5. trust_level=verified 但 source_type=external-register 时提示需要 B1.2
       管理员审核记录
    6. permissions.scopes 中 admin:runtime 持有者是否 ROLE_SYSTEM
    7. 模型配置：model.provider 是否指向集团推理平台 gateway
    8. tenant_mode、auth.mode 与 sd-default 部署清单是否对齐

【输出格式】
    [doctor] <AGENT.yaml> — 共 N 项诊断
      [OK]    spec=anp-agent/v1.2
      [WARN]  workspace_required=true，但当前部署清单未挂载 workspace volume
      [FAIL]  inference gateway BASE_URL 不可达：http://gateway.internal/health -> timeout
              fix: 配置 ZW_BRAIN_INFERENCE_GATEWAY_URL + ZW_BRAIN_INFERENCE_API_KEY
      [HINT]  trust_level=untrusted（默认安全态）；B1.2 审核通过后升 verified

【实装骨架】
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path
from typing import Any

ALLOWED_TRUST_LEVELS = ("platform", "verified", "untrusted")
SEVERITY_ORDER = {"OK": 0, "HINT": 1, "WARN": 2, "FAIL": 3}


def _diagnose(parsed: dict[str, Any], yaml_path: Path) -> list[tuple[str, str, str]]:
    """返回 (severity, area, message) 列表，severity ∈ {OK, HINT, WARN, FAIL}。

    T1 fire 时补真实探活（urllib / requests / docker exec workspace ls 等）。
    """
    diagnoses: list[tuple[str, str, str]] = []

    spec = parsed.get("spec")
    if spec in ("anp-agent/v1.1", "anp-agent/v1.2"):
        diagnoses.append(("OK", "spec", f"spec={spec}"))
    else:
        diagnoses.append(("FAIL", "spec", f"spec={spec!r} 不在白名单"))

    # inference gateway 探活
    gateway = os.getenv("ZW_BRAIN_INFERENCE_GATEWAY_URL")
    if not gateway:
        diagnoses.append((
            "FAIL",
            "inference",
            "ZW_BRAIN_INFERENCE_GATEWAY_URL 未配置；fix: 设置环境变量指向集团推理平台 gateway"
        ))
    # === T1 fire 时实装 urllib HEAD 探活 ===
    # else:
    #     try:
    #         from urllib.request import Request, urlopen
    #         req = Request(gateway + "/health", method="HEAD")
    #         urlopen(req, timeout=3).read()
    #         diagnoses.append(("OK", "inference", f"gateway {gateway} 可达"))
    #     except Exception as exc:
    #         diagnoses.append(("FAIL", "inference", f"gateway {gateway} 不可达：{exc}"))

    # workspace_required
    if parsed.get("workspace_required"):
        diagnoses.append((
            "WARN",
            "workspace",
            "workspace_required=true，T1 fire 后需要检查部署清单 workspace volume mount",
        ))

    # trust_level
    trust = parsed.get("trust_level") or "untrusted"
    if trust == "untrusted":
        diagnoses.append((
            "HINT",
            "trust_level",
            "trust_level=untrusted（默认安全态）；B1.2 管理员审核通过后可升 verified",
        ))
    elif trust == "verified":
        diagnoses.append((
            "HINT",
            "trust_level",
            "trust_level=verified；确认 B1.2 审核记录已留痕（trigger 化 pending — debt entry）",
        ))
    elif trust == "platform":
        # 检查 source_type
        source_type = parsed.get("source_type")
        if source_type != "builtin":
            diagnoses.append((
                "FAIL",
                "trust_level",
                f"trust_level=platform 仅限 source_type=builtin；当前 source_type={source_type!r}",
            ))

    # agent_yaml_ref 解析
    ref = parsed.get("agent_yaml_ref")
    if ref:
        if ref.startswith("oci://"):
            diagnoses.append((
                "HINT",
                "agent_yaml_ref",
                f"agent_yaml_ref={ref}；OCI pull 权限请用 oras 单独验证",
            ))
        else:
            ref_path = Path(ref)
            if not ref_path.is_absolute():
                ref_path = yaml_path.parent / ref
            if not ref_path.exists():
                diagnoses.append((
                    "FAIL",
                    "agent_yaml_ref",
                    f"agent_yaml_ref={ref} 不存在；fix: 修正路径或使用 OCI ref",
                ))
            else:
                diagnoses.append(("OK", "agent_yaml_ref", f"local file resolves to {ref_path}"))

    return diagnoses


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("path", type=Path)
    parser.add_argument("--fix", action="store_true", help="尝试自动修复（写 .env 模板等）")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    # === T1 fire 时实装真实 yaml 解析 ===
    parsed: dict[str, Any] = {}
    diagnoses = _diagnose(parsed, args.path)

    has_fail = any(sev == "FAIL" for sev, _, _ in diagnoses)
    diagnoses.sort(key=lambda d: SEVERITY_ORDER.get(d[0], 9), reverse=True)

    if args.json:
        print(json.dumps(
            [{"severity": s, "area": a, "message": m} for s, a, m in diagnoses],
            ensure_ascii=False,
            indent=2,
        ))
    else:
        print(f"[doctor] {args.path} — 共 {len(diagnoses)} 项诊断")
        for sev, area, msg in diagnoses:
            print(f"  [{sev}]\t{area}\t{msg}")

    return 1 if has_fail else 0


if __name__ == "__main__":
    sys.exit(main())
