# zw-brain .gitignore
#
# 原则：只跟踪政务大脑自身的设计、代码、契约与测试；IDE/OS 噪音、本地目录、
#       历史素材不入库。dev-rules 为本地 symlink → ~/Codes/dev-rules（见 CLAUDE.md）。

# Canonical dev-rules 镜像（本机 symlink，不入库；CI 浅克隆）
dev-rules
dev-rules/

# ── IDE / OS ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Python runtime noise ─────────────────────────────────────
__pycache__/
.pytest_cache/
*.pyc
.venv
.venv-py312
.ruff_cache/
*.egg-info/
build/
.mypy_cache/
dist/

# ── AgentRuntime 离线包解压目录（保留 tar.gz）────────────────────
vendor/agent-runtime/release/**/agent-runtime-*-py312-pyc-only/

# ── Test / coverage artifacts ─────────────────────────────────
.coverage
.coverage.*
coverage/
htmlcov/

# ── Secrets / local env overrides ─────────────────────────────
.env
.env.*
!.env.example

# ── Node (e.g. zw-brain-dashboard tooling) ─────────────────────
# 无尾斜杠：worktree 中常 `ln -s` 复用主 checkout 的依赖/数据，symlink 不被 `dir/` 匹配
node_modules

# ── Local runtime state ────────────────────────────────────────
.data
.legacy_cache/

# ── Claude local session state ─────────────────────────────────
.claude/

# ── Cursor local secrets (示例见 dev-rules templates) ───────────
.cursor/cloud-agent.env

# ── 本地 PR / review 草稿（含 markdown / JSON；不入库）──────────
.reviews/

# ── 本地工作区目录（每人不同，不入库）──────────────────────────
hub/

# ── 历史素材（本地保留，不随仓库分发）──────────────────────────
# old/：旧平台白皮书、会议素材、截图等；integrated-bigdata-platform 等于 2026-04-18 自 docs/ 迁入。
# 同时排除 symlink（worktree 中常用 `ln -s ../../../old old` 复用本地 mirror）
old/
/old

.xuejiao-twin*

tests/test_temp_token.py
test-results/

# CI-scoped (seed-light/e2e-only) measurement — 验证态非权威，绝不入库
.testing/status/measurement/ci-scoped/

# e2e 走查截图（本地/CI 采集，不入库；权威验收证据见各 scope 的 evidence.json）
.testing/acceptance/**/*.png

# docker-compose override 文件（由 start-docker.sh 自动生成，不入库）
.compose.override.yml
