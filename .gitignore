# zw-brain .gitignore
#
# 原则：只跟踪政务大脑自身的设计、代码、契约与测试；IDE/OS 噪音、本地目录、
#       历史素材不入库。（长篇研究档见 dev-rules 子模块内 digital-clone-research.md。）

# ── IDE / OS ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Python runtime noise ─────────────────────────────────────
__pycache__/
.pytest_cache/
*.pyc
.venv/
.ruff_cache/

# ── Local runtime state ──────────────────────────────────────
.data/
dist/

# ── Claude local session state ───────────────────────────────
.claude/

# ── 本地工作区目录（每人不同，不入库）────────────────────────
hub/

# ── 历史素材（本地保留，不随仓库分发）────────────────────────
# old/：旧平台白皮书、会议素材、截图等；integrated-bigdata-platform 等于 2026-04-18 自 docs/ 迁入。
old/
