{
  "slug": "delivery.status.explain",
  "title": "P4 交付状态解释助手（阶段 / 异常原因 / 影响范围）",
  "description": "P4 交付任务详情页减摩组件。输入交付任务 id（delivery_code 或 application_code），输出当前阶段语义解释、异常原因、影响范围与责任归属。证据基于交付任务字段；仅解释不评价。zw-brain 主进程不持有推理平台 SDK/env，当前走本地确定性规则。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "delivery_code": {
        "type": "string"
      },
      "application_code": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "enabled": {
        "type": "boolean"
      },
      "request_id": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "delivery_code": {
        "type": "string"
      },
      "application_code": {
        "type": "string"
      },
      "phase": {
        "type": "string"
      },
      "phase_label": {
        "type": "string"
      },
      "phase_description": {
        "type": "string"
      },
      "exception_reasons": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "impact_scope": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "responsible_role": {
        "type": "string"
      },
      "evidence_sources": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "source": {
        "type": "string"
      },
      "enabled": {
        "type": "boolean"
      },
      "degraded": {
        "type": "boolean",
        "description": "兼容旧客户端的可选字段；当前 zw-brain 本地规则路径不设置。"
      },
      "status": {
        "type": "string",
        "description": "not_found 时返回"
      },
      "hint": {
        "type": "string"
      }
    }
  },
  "side_effects": [
    "audit"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "delivery.status.explain"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "delivery.status.explain.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "delivery",
    "explain",
    "assistant",
    "read"
  ],
  "product_scope": {
    "journey": "j1",
    "status": "live"
  }
}
