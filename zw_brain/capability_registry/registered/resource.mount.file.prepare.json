        "type": "string"
      },
      "owner_org_id": {
        "type": "string"
      },
      "file_name": {
        "type": "string"
      },
      "access_path": {
        "type": "string"
      },
      "content_hash": {
        "type": "string"
      },
      "update_frequency": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      },
