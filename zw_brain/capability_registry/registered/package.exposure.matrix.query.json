{
  "slug": "package.exposure.matrix.query",
  "title": "查询能力包暴露矩阵",
  "description": "返回全量 capability manifest × 5 消费面（webui/api/cli/mcp/a2a）暴露矩阵；只读、按 journey/status/binding 维度筛选。数据派生自 zw_brain/capability_registry/registered/*.json 的 compatibility / product_scope / execution_binding 字段，不重新计算。handler 自身写一条 read-sensitive sanitized meta-audit（与 F2/F3 同 pattern）。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "journey": {
        "type": "string",
        "enum": [
          "j1",
          "j2",
          "b1",
          "infra",
          "external",
          "national"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "live",
          "external",
          "deferred:wave-1",
          "deferred:wave-2",
          "deferred:wave-3",
          "deferred:wave-4"
        ]
      },
      "execution_binding": {
        "type": "string",
        "enum": [
          "builtin",
          "external_capability"
        ]
      },
      "surface": {
        "type": "string",
        "enum": [
          "webui",
          "api",
          "cli",
          "mcp",
          "a2a"
        ]
      },
      "tenant_id": {
        "type": "string"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "default": 500
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "matrix",
      "totals",
      "scanned"
    ],
    "properties": {
      "matrix": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "skill_id",
            "journey",
            "status",
            "execution_binding",
            "surfaces"
          ],
          "properties": {
            "skill_id": {
              "type": "string"
            },
            "journey": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "execution_binding": {
              "type": "string"
            },
            "audit_class": {
              "type": "string"
            },
            "surfaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "human_confirmation_required": {
              "type": "boolean"
            },
            "trust_level": {
              "type": "string"
            }
          }
        }
      },
      "totals": {
        "type": "object",
        "properties": {
          "manifests": {
            "type": "integer"
          },
          "by_surface": {
            "type": "object"
          },
          "by_journey": {
            "type": "object"
          },
          "by_status": {
            "type": "object"
          },
          "by_execution_binding": {
            "type": "object"
          }
        }
      },
      "scanned": {
        "type": "integer"
      }
    }
  },
  "side_effects": [],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read-sensitive",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "package.exposure.matrix.query"
  },
  "rollback_target": null,
  "audit_required": false,
  "permissions": [
    "package.exposure.matrix.query.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "package",
    "read",
    "registry",
    "exposure"
  ],
  "product_scope": {
    "journey": "b1",
    "status": "live"
  }
}
