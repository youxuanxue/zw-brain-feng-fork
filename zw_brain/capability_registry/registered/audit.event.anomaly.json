{
  "slug": "audit.event.anomaly",
  "title": "审计事件异常 Top-N 扫描",
  "description": "Rule-based 异常事件 Top-N 扫描，三类内建规则：(1) 跨租户读 cross-tenant-read；(2) 单 actor 高频失败 high-failure-rate；(3) 反复 denied request_id repeated-denied。返回每条异常的证据 request_id + 命中规则；不返回原始 payload 全文。用于 B1.1 异常 + 督查 panel。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "since": {
        "type": "string",
        "format": "date-time"
      },
      "until": {
        "type": "string",
        "format": "date-time"
      },
      "top_n": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20
      },
      "min_failure_count": {
        "type": "integer",
        "minimum": 2,
        "default": 3,
        "description": "high-failure-rate 规则的最低失败次数阈值"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "anomalies",
      "scanned"
    ],
    "properties": {
      "anomalies": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "rule",
            "severity",
            "actor",
            "evidence_request_ids",
            "summary"
          ],
          "properties": {
            "rule": {
              "type": "string",
              "enum": [
                "cross-tenant-read",
                "high-failure-rate",
                "repeated-denied"
              ]
            },
            "severity": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "actor": {
              "type": "string"
            },
            "skill_id": {
              "type": "string"
            },
            "tenant_id": {
              "type": "string"
            },
            "evidence_request_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "occurrence_count": {
              "type": "integer"
            },
            "summary": {
              "type": "string"
            }
          }
        }
      },
      "scanned": {
        "type": "integer"
      }
    }
  },
  "side_effects": [],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read-sensitive",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "audit.event.anomaly"
  },
  "rollback_target": null,
  "audit_required": false,
  "permissions": [
    "audit.event.anomaly.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "audit",
    "read",
    "compliance",
    "anomaly"
  ],
  "product_scope": {
    "journey": "b1",
    "status": "live"
  }
}
