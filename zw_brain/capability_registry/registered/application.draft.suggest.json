{
  "slug": "application.draft.suggest",
  "title": "P3 申请草拟助手（预填字段 + 风险预估）",
  "description": "P3 申请页减摩组件。基于资源名称、申请方、使用场景与历史相似申请，预填申请字段（purpose / use_reason / use_item / service_times / use_region 等）并给出风险评分。仅作辅助建议，绝不调用申请提交接口。zw-brain 主进程不持有推理平台 SDK/env，当前走本地确定性规则。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "resource_name": {
        "type": "string"
      },
      "applicant_org": {
        "type": "string"
      },
      "use_case": {
        "type": "string",
        "description": "使用场景一句话描述"
      },
      "role": {
        "type": "string"
      },
      "enabled": {
        "type": "boolean"
      },
      "request_id": {
        "type": "string"
      }
    },
    "required": [
      "resource_name",
      "applicant_org"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "suggested_fields": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string"
          },
          "use_reason": {
            "type": "string"
          },
          "use_item": {
            "type": "string"
          },
          "service_times": {
            "type": "integer"
          },
          "service_times_unit": {
            "type": "string"
          },
          "use_region": {
            "type": "string"
          }
        }
      },
      "risk_score": {
        "type": "integer"
      },
      "risk_band": {
        "type": "string",
        "description": "low | medium | high"
      },
      "risk_factors": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "missing_fields": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "recommended_use_reasons": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "reasoning": {
        "type": "string"
      },
      "source": {
        "type": "string"
      },
      "enabled": {
        "type": "boolean"
      },
      "degraded": {
        "type": "boolean",
        "description": "兼容旧客户端的可选字段；当前 zw-brain 本地规则路径不设置。"
      },
      "historical_examples_count": {
        "type": "integer"
      }
    }
  },
  "side_effects": [
    "audit"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "application.draft.suggest"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "application.draft.suggest.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "application",
    "draft",
    "assistant",
    "read"
  ],
  "product_scope": {
    "journey": "j1",
    "status": "live"
  }
}
