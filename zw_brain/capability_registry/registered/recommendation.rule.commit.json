{
  "slug": "recommendation.rule.commit",
  "title": "提交推荐规则入库",
  "description": "管理员把项目级推荐规则模板从 preview 态确认入库（version+1，进入 live），是 R14 三引擎草稿→预览→入库三步的最后一步。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "tenant_id",
      "confirmed"
    ],
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "rule_id": {
        "type": "string"
      },
      "rule_code": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "draft_source_text": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      },
      "role": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "ok",
      "skill_id",
      "audit_id",
      "result"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "skill_id": {
        "type": "string"
      },
      "audit_id": {
        "type": "string"
      },
      "result": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "committed_at": {
            "type": "string"
          }
        }
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "recommendation.rule.commit"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "recommendation.rule.commit.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "recommendation",
    "rule",
    "commit",
    "write",
    "wave2",
    "engine"
  ],
  "product_scope": {
    "journey": "b1",
    "status": "live"
  }
}
