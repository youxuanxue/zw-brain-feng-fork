{
  "slug": "package.rollback",
  "title": "回滚能力包版本",
  "description": "将能力包当前活跃版本回滚到上一个已注册版本（package.registeredVersion ← rollbackTarget）。回滚操作 write-critical 强制 human_confirmation_required=true；写主库 + 写审计。回滚不动 manifest 文件本身，仅切换 capability_package 表里的 active version；rollback_target 在回滚前必须存在。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "package_id",
      "confirmed"
    ],
    "properties": {
      "package_id": {
        "type": "string",
        "minLength": 1
      },
      "target_version": {
        "type": "string",
        "description": "回滚目标版本号；缺省走 capability_package.rollbackTarget"
      },
      "reason": {
        "type": "string",
        "description": "回滚原因（业务侧记录；落审计 payload）"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "ok",
      "skill_id",
      "audit_id",
      "result"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "skill_id": {
        "type": "string"
      },
      "audit_id": {
        "type": "string"
      },
      "result": {
        "type": "object",
        "required": [
          "package_id",
          "previous_version",
          "rolled_back_to"
        ],
        "properties": {
          "package_id": {
            "type": "string"
          },
          "previous_version": {
            "type": "string"
          },
          "rolled_back_to": {
            "type": "string"
          },
          "rollback_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write",
    "state_machine_transition"
  ],
  "audit_required": true,
  "permissions": [
    "package.rollback.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "package",
    "write",
    "registry",
    "rollback"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "package.rollback"
  },
  "rollback_target": null,
  "product_scope": {
    "journey": "b1",
    "status": "live"
  }
}
