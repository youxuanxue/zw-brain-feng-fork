{
  "title": "AI 建议填充草稿",
  "description": "对草稿申请的空字段生成 AI 建议值并标记为「AI建议·待确认」；只填空、不覆盖人工填写或确定性带出的字段。AI 建议永不自动提交——人核对修订后手动提交即审批担责。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "request_id"
    ],
    "properties": {
      "request_id": {
        "type": "string",
        "minLength": 1
      },
      "role": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "ok",
      "skill_id",
      "audit_id",
      "result"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "skill_id": {
        "type": "string"
      },
      "audit_id": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write"
  ],
  "audit_required": true,
  "permissions": [
    "request.draft.ai_suggest.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "request",
    "form",
    "ai",
    "write"
  ],
  "slug": "request.draft.ai_suggest",
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "write-default",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "request.draft.ai_suggest"
  },
  "rollback_target": null,
  "product_scope": {
    "journey": "j1",
    "status": "live"
  }
}
