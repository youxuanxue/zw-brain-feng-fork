{
  "slug": "delivery.receipt.ingest",
  "title": "摄取交付回执",
  "description": "摄取交换执行、下载、授权或订阅回执，只写回执、证据和投影。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string"
      },
      "attempt_id": {
        "type": "string"
      },
      "receipt_status": {
        "type": "string",
        "enum": [
          "succeeded",
          "failed",
          "partial",
          "unknown"
        ]
      },
      "receipt": {
        "type": "object"
      },
      "metrics": {
        "type": "object"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    },
    "required": [
      "task_id",
      "receipt_status",
      "confirmed"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "total": {
        "type": "integer"
      },
      "result": {
        "type": "object"
      },
      "ok": {
        "type": "boolean"
      },
      "summary": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write",
    "blockchain_anchor"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-normal",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "delivery.receipt.ingest"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "delivery.receipt.ingest.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "delivery",
    "receipt",
    "evidence",
    "write"
  ],
  "product_scope": {
    "journey": "j1",
    "status": "live"
  }
}
