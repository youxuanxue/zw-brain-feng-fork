{
  "slug": "application.escalate_national",
  "title": "转报国家平台",
  "description": "业务运营员把本级已审核通过的申请转报到国家平台（国家直达子旅程）。打应用层计算态「国家通道转报中」并经国家通道适配出站，不污染 J1 主状态枚举。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      },
      "application_code": {
        "type": "string"
      },
      "action": {
        "type": "string"
      },
      "reason": {
        "type": "string"
      }
    },
    "required": [
      "confirmed",
      "application_code"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "application_code": {
        "type": "string"
      },
      "national_channel_stage": {
        "type": "string"
      },
      "display_status": {
        "type": "string"
      },
      "national_channel": {
        "type": "object"
      },
      "run": {
        "type": [
          "object",
          "null"
        ]
      },
      "audit_id": {
        "type": "string"
      }
    }
  },
  "side_effects": [
    "audit",
    "adapter_receipt"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "adapter-write",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "application.escalate_national"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "application.escalate_national.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "application",
    "national",
    "escalate",
    "direct"
  ],
  "product_scope": {
    "journey": "j1",
    "status": "live"
  }
}
