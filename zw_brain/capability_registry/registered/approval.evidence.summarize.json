{
  "slug": "approval.evidence.summarize",
  "title": "P3 审批依据助手（归纳依据 + 反事实 + 推荐结论）",
  "description": "P3 审批页减摩组件。输入待审申请 id，归纳支持依据 / 反事实因素 / 推荐审批结论 (approve|return_for_fix|reject)。仅作辅助提示，绝不调用审批决策接口。推理走集团推理平台统一通道；推理失败时回落本地规则。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "application_id": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "enabled": {
        "type": "boolean"
      },
      "request_id": {
        "type": "string"
      }
    },
    "required": [
      "application_id"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "application_id": {
        "type": "string"
      },
      "application_status": {
        "type": "string"
      },
      "bases": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "counter_factuals": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "recommendation": {
        "type": "string",
        "description": "approve | return_for_fix | reject"
      },
      "recommended_decision_reason": {
        "type": "string"
      },
      "historical_summary": {
        "type": "string"
      },
      "source": {
        "type": "string"
      },
      "enabled": {
        "type": "boolean"
      },
      "degraded": {
        "type": "boolean"
      },
      "status": {
        "type": "string",
        "description": "not_found 时返回"
      },
      "hint": {
        "type": "string"
      }
    }
  },
  "side_effects": [
    "audit"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "approval.evidence.summarize"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "approval.evidence.summarize.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "approval",
    "evidence",
    "assistant",
    "read"
  ],
  "product_scope": {
    "journey": "j1",
    "status": "live"
  }
}
