{
  "slug": "governance.policy_candidate.review",
  "title": "审核旧权限映射候选",
  "description": "对 legacy_policy_mapping_candidate 执行批准/驳回；可选将已批准候选合并写入 tenant_capability_policy（须经人工确认）。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "decision",
      "confirmed"
    ],
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "decision": {
        "type": "string",
        "enum": [
          "approve",
          "reject",
          "apply",
          "approve_and_apply"
        ]
      },
      "confirmed": {
        "type": "boolean"
      },
      "review_note": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "legacy_system": {
        "type": "string"
      },
      "legacy_permission_ref": {
        "type": "string"
      },
      "capability_id": {
        "type": "string"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "skill_id": {
        "type": "string"
      },
      "audit_id": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write",
    "blockchain_anchor"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "governance.policy_candidate.review"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "governance.policy_candidate.review.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "governance",
    "policy-candidate",
    "review",
    "write"
  ],
  "product_scope": {
    "journey": "b1",
    "status": "live"
  }
}
