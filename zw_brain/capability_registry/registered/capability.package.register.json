{
  "slug": "capability.package.register",
  "title": "登记能力包",
  "description": "将能力包登记到统一 registry 候审，不授予主状态写权。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "slug",
      "confirmed"
    ],
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      },
      "package_id": {
        "type": "string"
      },
      "slug": {
        "type": "string"
      },
      "source": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "exposure": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "contract": {
        "type": "object"
      },
      "tenantPolicy": {
        "type": "object"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "ok",
      "skill_id",
      "audit_id",
      "result"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "skill_id": {
        "type": "string"
      },
      "audit_id": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write",
    "blockchain_anchor"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "capability.package.register"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "capability.package.register.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "capability",
    "package",
    "register",
    "write"
  ],
  "product_scope": {
    "journey": "b1",
    "status": "live"
  }
}
