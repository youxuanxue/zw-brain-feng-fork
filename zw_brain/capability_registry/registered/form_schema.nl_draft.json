{
  "slug": "form_schema.nl_draft",
  "title": "用一句话生成表单 schema 草稿",
  "description": "管理员一句话描述表单字段意向 → 通过本地确定性规则生成 schema 草稿入 draft 态；不自动入库，须经 promote→commit 三步流程。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "tenant_id",
      "form_code",
      "title",
      "intent_text"
    ],
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "form_code": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "intent_text": {
        "type": "string"
      },
      "deterministic_only": {
        "type": "boolean"
      },
      "role": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "ok",
      "skill_id",
      "audit_id",
      "result"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "skill_id": {
        "type": "string"
      },
      "audit_id": {
        "type": "string"
      },
      "result": {
        "type": "object",
        "properties": {
          "schema_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "source_kind": {
            "type": "string"
          },
          "draft_source_text": {
            "type": "string"
          },
          "payload_summary": {
            "type": "object"
          },
          "source_metadata": {
            "type": "object"
          }
        }
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read-normal",
  "execution_binding": "builtin",
  "config_change_class": "draft",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "form_schema.nl_draft"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "form_schema.nl_draft.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "form_schema",
    "nl_draft",
    "wave2",
    "engine"
  ],
  "product_scope": {
    "journey": "b1",
    "status": "live"
  }
}
