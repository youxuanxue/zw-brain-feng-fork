{
  "slug": "metadata.schema.snapshot.upsert",
  "title": "记录 Schema 快照",
  "description": "记录外部采集或资源绑定返回的 schema 快照，只作为受控证据进入 zw-brain。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "resource_code",
      "schema_json",
      "confirmed"
    ],
    "properties": {
      "snapshot_ref": {
        "type": "string"
      },
      "resource_code": {
        "type": "string",
        "minLength": 1
      },
      "binding_code": {
        "type": "string"
      },
      "schema_json": {
        "type": "object"
      },
      "schema_hash": {
        "type": "string"
      },
      "captured_at": {
        "type": "string"
      },
      "source_ref": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write",
    "blockchain_anchor"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "metadata.schema.snapshot.upsert"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "metadata.schema.snapshot.upsert.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "metadata",
    "schema",
    "evidence",
    "write"
  ],
  "product_scope": {
    "journey": "infra",
    "status": "live"
  }
}
