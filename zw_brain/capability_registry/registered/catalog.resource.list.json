{
  "slug": "catalog.resource.list",
  "title": "列目录下的资源",
  "description": "给定 catalog_code，钻取列出该目录关联的所有 resource_asset（一对多）。目录存在但无资源时返回空列表（诚实空态），目录不存在返回 404。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "catalog_code"
    ],
    "properties": {
      "catalog_code": {
        "type": "string"
      },
      "page": {
        "type": "integer",
        "minimum": 1,
        "default": 1
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20
      },
      "lifecycle": {
        "type": "string"
      },
      "role": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "catalog",
      "items",
      "total",
      "page",
      "limit"
    ],
    "properties": {
      "catalog": {
        "type": "object"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "total": {
        "type": "integer",
        "minimum": 0
      },
      "page": {
        "type": "integer",
        "minimum": 1
      },
      "limit": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "side_effects": [],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read-default",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "catalog.resource.list"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "catalog.resource.list.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "catalog",
    "resource",
    "drilldown",
    "read"
  ],
  "product_scope": {
    "journey": "j1",
    "status": "live"
  }
}
