{
  "slug": "demand.register",
  "title": "登记供需需求",
  "description": "用户在 P3 找不到可复用资源时登记需求，写入 application_record kind=demand。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      },
      "demand_id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "applicant": {
        "type": "string"
      },
      "applicant_dept": {
        "type": "string"
      },
      "target_resource_hint": {
        "type": "string"
      }
    },
    "required": [
      "title",
      "confirmed"
    ]
  },
  "output_schema": {
    "type": "object"
  },
  "side_effects": [
    "audit",
    "db_write"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-normal",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "demand.register"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "demand.register.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "demand",
    "supply",
    "write"
  ],
  "product_scope": {
    "journey": "j1",
    "status": "live"
  }
}
