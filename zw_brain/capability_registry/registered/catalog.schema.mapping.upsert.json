{
  "slug": "catalog.schema.mapping.upsert",
  "title": "确认目录字段映射",
  "description": "记录目录项与资源 schema 字段之间的确认映射，形成可追溯的重构证据链。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "catalog_code",
      "catalog_item_code",
      "resource_code",
      "binding_code",
      "confirmed"
    ],
    "properties": {
      "mapping_code": {
        "type": "string"
      },
      "catalog_code": {
        "type": "string",
        "minLength": 1
      },
      "catalog_item_code": {
        "type": "string",
        "minLength": 1
      },
      "resource_code": {
        "type": "string",
        "minLength": 1
      },
      "binding_code": {
        "type": "string",
        "minLength": 1
      },
      "source_schema_ref": {
        "type": "object"
      },
      "mapping_rule_json": {
        "type": "object"
      },
      "confidence_level": {
        "type": "string"
      },
      "evidence_ref": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "source_ref": {
        "type": "string"
      },
      "legacy_object_ref": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write",
    "blockchain_anchor"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "catalog.schema.mapping.upsert"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "catalog.schema.mapping.upsert.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "catalog",
    "schema",
    "mapping",
    "write"
  ],
  "product_scope": {
    "journey": "j2",
    "status": "live"
  }
}
