{
  "slug": "governance.actor.status.set",
  "title": "停用/启用用户",
  "description": "设置 actor 生命周期状态（active/disabled）。停用后该 actor 在认证边界 fail-closed（再登录不再被复活为 active），其角色绑定保留以便启用即恢复。带审计、须人工确认。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "external_actor_id",
      "status",
      "confirmed"
    ],
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "external_actor_id": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "disabled"
        ]
      },
      "confirmed": {
        "type": "boolean"
      },
      "note": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "audit_id": {
        "type": "string"
      },
      "external_actor_id": {
        "type": "string"
      },
      "status": {
        "type": "string"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "governance.actor.status.set"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "governance.actor.status.set.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "governance",
    "iam",
    "actor",
    "lifecycle",
    "write"
  ],
  "product_scope": {
    "journey": "b1",
    "status": "live"
  }
}
