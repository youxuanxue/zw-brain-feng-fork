{
  "slug": "platform.docs.search",
  "title": "平台文档关键词检索",
  "description": "在 zw-brain 仓库 docs/ 等只读文档中按关键词检索，返回路径、标题与摘要片段，供平台问答 Agent 定位资料。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "检索关键词或短语"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "default": 8
      },
      "role": {
        "type": "string"
      },
      "request_id": {
        "type": "string"
      }
    },
    "required": [
      "query"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      },
      "hits": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "total": {
        "type": "integer"
      }
    }
  },
  "side_effects": [],
  "audit_required": true,
  "permissions": [
    "platform.docs.search.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "platform-docs",
    "help",
    "read-only"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read-default",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "platform.docs.search"
  },
  "rollback_target": null,
  "product_scope": {
    "journey": "infra",
    "status": "live"
  }
}
