{
  "slug": "capability.version.review",
  "title": "审核能力版本",
  "description": "复用能力包审核状态机裁决版本是否可进入登记。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "package_id",
      "decision",
      "confirmed"
    ],
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      },
      "package_id": {
        "type": "string"
      },
      "decision": {
        "type": "string",
        "enum": [
          "approve",
          "return_for_fix",
          "reject"
        ]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "ok",
      "skill_id",
      "audit_id",
      "result"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "skill_id": {
        "type": "string"
      },
      "audit_id": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write",
    "blockchain_anchor"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "capability.version.review"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "capability.version.review.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "capability",
    "version",
    "review",
    "write"
  ],
  "product_scope": {
    "journey": "b1",
    "status": "live"
  }
}
