{
  "slug": "demand.response.submit",
  "title": "提交供需响应",
  "description": "提供方对供需需求提交确认提供、拒绝提供或驳回补正结论；确认提供时必须关联资源。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      },
      "demand_id": {
        "type": "string"
      },
      "decision": {
        "type": "string",
        "enum": [
          "provide",
          "reject",
          "need_fix"
        ]
      },
      "response_note": {
        "type": "string"
      },
      "resource_ref": {
        "type": "string"
      }
    },
    "required": [
      "demand_id",
      "decision",
      "response_note",
      "confirmed"
    ]
  },
  "output_schema": {
    "type": "object"
  },
  "side_effects": [
    "audit",
    "db_write"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-normal",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "demand.response.submit"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "demand.response.submit.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "demand",
    "supply",
    "write"
  ],
  "product_scope": {
    "journey": "j1",
    "status": "live"
  }
}
