{
  "slug": "catalog.entry.query",
  "title": "查询目录条目",
  "description": "查询已进入 canonical 聚合的目录条目详情和列表。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      },
      "catalog_code": {
        "type": "string"
      },
      "source": {
        "type": "string",
        "description": "filter by summary_json.source (e.g. 'reverse' for 反向编目 drafts)"
      },
      "lifecycle_status": {
        "type": "string",
        "description": "filter by lifecycle_status (draft / pending_review / active / ...)"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "description": "max rows to return; filters apply in SQL before serialization"
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "description": "skip rows before applying limit"
      },
      "order": {
        "type": "string",
        "enum": [
          "updated_desc"
        ],
        "description": "result ordering: 'updated_desc' = newest updated first (work-queue view); default = catalog_code ascending (stable browse order)"
      },
      "role": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "total": {
        "type": "integer"
      }
    }
  },
  "side_effects": [],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read-trace",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "catalog.entry.query"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "catalog.entry.query.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "catalog",
    "entry",
    "read"
  ],
  "product_scope": {
    "journey": "j1",
    "status": "live"
  }
}
