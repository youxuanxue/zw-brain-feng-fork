{
  "slug": "ops.catalog.quality.upsert",
  "title": "记录目录质量证据",
  "description": "记录目录、目录项或资源质量检测结果，作为治理解释与审计证据。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "quality_ref",
      "target_type",
      "target_ref",
      "quality_status",
      "confirmed"
    ],
    "properties": {
      "quality_ref": {
        "type": "string",
        "minLength": 1
      },
      "target_type": {
        "type": "string"
      },
      "target_ref": {
        "type": "string",
        "minLength": 1
      },
      "quality_status": {
        "type": "string"
      },
      "score": {
        "type": "number"
      },
      "evidence_json": {
        "type": "object"
      },
      "source_ref": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write",
    "blockchain_anchor"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "ops.catalog.quality.upsert"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "ops.catalog.quality.upsert.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "ops",
    "catalog",
    "quality",
    "write"
  ],
  "product_scope": {
    "journey": "external",
    "status": "external"
  }
