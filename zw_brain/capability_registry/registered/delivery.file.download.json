{
  "slug": "delivery.file.download",
  "title": "文件资源下载",
  "description": "为文件类交付任务生成受控下载链接并登记下载日志（链接/文件名/大小/下载时间/下载方）。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "task_id",
      "confirmed"
    ],
    "properties": {
      "task_id": {
        "type": "string",
        "minLength": 1
      },
      "file_name": {
        "type": "string"
      },
      "file_size": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "ok",
      "skill_id",
      "audit_id",
      "result"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "skill_id": {
        "type": "string"
      },
      "audit_id": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-default",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "delivery.file.download"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "delivery.file.download.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "delivery",
    "file",
    "download",
    "write"
  ],
  "product_scope": {
    "journey": "j1",
    "status": "live"
  }
}
