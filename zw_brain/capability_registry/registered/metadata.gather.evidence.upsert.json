{
  "slug": "metadata.gather.evidence.upsert",
  "title": "记录元数据采集证据",
  "description": "记录外部元数据采集任务回执，采集成败不直接改变资源业务状态。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "gather_task_ref",
      "resource_code",
      "confirmed"
    ],
    "properties": {
      "gather_task_ref": {
        "type": "string",
        "minLength": 1
      },
      "resource_code": {
        "type": "string",
        "minLength": 1
      },
      "source_system_ref": {
        "type": "string"
      },
      "schema_snapshot_ref": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "error_summary": {
        "type": "string"
      },
      "evidence_json": {
        "type": "object"
      },
      "started_at": {
        "type": "string"
      },
      "finished_at": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write",
    "blockchain_anchor"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "metadata.gather.evidence.upsert"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "metadata.gather.evidence.upsert.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "metadata",
    "gather",
    "evidence",
    "write"
  ],
  "product_scope": {
    "journey": "infra",
    "status": "live"
  }
}
