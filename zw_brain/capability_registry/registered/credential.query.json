{
  "slug": "credential.query",
  "title": "查询访问凭据（P4 凭据领取页）",
  "description": "只读。返回某 request 已签发的 credential（app_key + app_secret + 有效期 + 配额 + 调用 URL 模板）。申请人 / 审批人 / 主管部门 / 审计员均可查（受 policy 控制）。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "request_id": {
        "type": "string"
      },
      "role": {
        "type": "string"
      }
    },
    "required": [
      "request_id"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "request_id": {
        "type": "string"
      },
      "credential": {
        "type": "object"
      },
      "status": {
        "type": "string",
        "description": "issued | not_issued"
      },
      "issued_audit_id": {
        "type": "string"
      },
      "issued_at": {
        "type": "string"
      },
      "issued_by": {
        "type": "string"
      },
      "resource_id": {
        "type": "string"
      },
      "resource_name": {
        "type": "string"
      },
      "hint": {
        "type": "string"
      }
    }
  },
  "side_effects": [],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "credential.query"
  },
  "rollback_target": null,
  "audit_required": false,
  "permissions": [
    "credential.query.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "credential",
    "query",
    "read"
  ],
  "product_scope": {
    "journey": "j1",
    "status": "live"
  }
}
