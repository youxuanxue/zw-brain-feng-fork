{
  "slug": "package.trust_level.update",
  "title": "升降能力包信任级",
  "description": "更新能力包的 trust_level 业务字段（基线级 baseline / 已审 reviewed / 严管 restricted / 撤回 revoked 四档）。本字段是 **能力包内置元数据**，描述本平台对该能力包的信任评估；与 AgentRuntime Registry 的 trust_level（F6 T1 触发，描述外部 Agent 来源信任级）不同——前者由 BUSIAUDIT / SECURITY_ADMIN 决定能否启用，后者由 AgentRuntime supervisor 决定能否消费 Agent。本 F4 只处理 manifest 字段；F6 触发后再增 Registry 字段。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "package_id",
      "trust_level",
      "confirmed"
    ],
    "properties": {
      "package_id": {
        "type": "string",
        "minLength": 1
      },
      "trust_level": {
        "type": "string",
        "enum": [
          "baseline",
          "reviewed",
          "restricted",
          "revoked"
        ],
        "description": "目标信任级（能力包内置元数据，**非** AgentRuntime Registry 字段）"
      },
      "reason": {
        "type": "string",
        "description": "升降级原因；落审计 payload"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "ok",
      "skill_id",
      "audit_id",
      "result"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "skill_id": {
        "type": "string"
      },
      "audit_id": {
        "type": "string"
      },
      "result": {
        "type": "object",
        "required": [
          "package_id",
          "previous_trust_level",
          "new_trust_level"
        ],
        "properties": {
          "package_id": {
            "type": "string"
          },
          "previous_trust_level": {
            "type": "string"
          },
          "new_trust_level": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write",
    "state_machine_transition"
  ],
  "audit_required": true,
  "permissions": [
    "package.trust_level.update.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "package",
    "write",
    "registry",
    "trust_level"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "package.trust_level.update"
  },
  "rollback_target": null,
  "product_scope": {
    "journey": "b1",
    "status": "live"
  }
}
