{
  "slug": "datasource.endpoint.upsert",
  "title": "注册或更新数据源",
  "description": "写：注册/更新数据源 endpoint；密码只落 secret_ref，禁止明文入库。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "endpoint_id": { "type": "string" },
      "display_name": { "type": "string" },
      "db_name": { "type": "string" },
      "db_type": { "type": "string" },
      "host_display": { "type": "string" },
      "port": { "type": "integer" },
      "org_code": { "type": "string" },
      "org_name": { "type": "string" },
      "contact_name": { "type": "string" },
      "contact_phone": { "type": "string" },
      "data_partition": { "type": "string" },
      "remark": { "type": "string" },
      "role": { "type": "string" },
      "confirmed": { "type": "boolean" }
    },
    "required": ["display_name", "db_name", "confirmed"]
  },
  "output_schema": { "type": "object" },
  "side_effects": ["audit", "db_write"],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": ["webui", "api", "cli", "a2a"],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "datasource.endpoint.upsert"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": ["datasource.endpoint.upsert.execute"],
  "author": { "org": "inspur-cloud", "contact": "zw-brain@inspur.com" },
  "registry_source": "internal",
  "tags": ["datasource", "write"],
  "product_scope": { "journey": "j2", "status": "live" }
}
