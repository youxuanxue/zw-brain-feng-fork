{
  "slug": "form_schema.revert_to_draft",
  "title": "表单模板：预览回退到草稿",
  "description": "管理员把项目级表单模板从 preview 回退到 draft 再编辑；不影响 live 态历史版本。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "tenant_id",
      "schema_id",
      "confirmed"
    ],
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "schema_id": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      },
      "reason": {
        "type": "string"
      },
      "role": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "ok",
      "skill_id",
      "audit_id",
      "result"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "skill_id": {
        "type": "string"
      },
      "audit_id": {
        "type": "string"
      },
      "result": {
        "type": "object",
        "properties": {
          "schema_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          }
        }
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-normal",
  "execution_binding": "builtin",
  "config_change_class": "draft",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "form_schema.revert_to_draft"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "form_schema.revert_to_draft.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "form_schema",
    "revert",
    "wave2",
    "engine"
  ],
  "product_scope": {
    "journey": "b1",
    "status": "live"
  }
}
