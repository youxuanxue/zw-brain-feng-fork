{
  "slug": "projection.status.query",
  "title": "查询 5 类投影状态 + 失败摘要",
  "description": "聚合 search / 共享专题 / 质量 / 血缘 / 运营统计 5 类投影 record，按类型返回 total_rows / latest_updated_at / failed_count / failure_summary，给 业务运营员 / 安全审计员 看投影 pipeline 健康度。只读，零 side effect。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "role": {
        "type": "string"
      },
      "tenant_id": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "projections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "total_rows": {
              "type": "integer"
            },
            "latest_updated_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "failed_count": {
              "type": "integer"
            },
            "failure_summary": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      },
      "overall_health": {
        "type": "string"
      }
    }
  },
  "side_effects": [],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read-trace",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "projection.status.query"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "projection.status.query.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
