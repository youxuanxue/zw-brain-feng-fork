  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "capability.version.submit.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "capability",
    "version",
    "submit",
    "write"
