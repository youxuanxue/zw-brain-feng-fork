{
  "slug": "capability.version.submit",
  "title": "提交能力版本登记",
  "description": "审核通过后把能力包版本登记到统一 registry。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "package_id",
      "confirmed"
    ],
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      },
      "package_id": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "ok",
      "skill_id",
      "audit_id",
      "result"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "skill_id": {
        "type": "string"
      },
      "audit_id": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "side_effects": [
