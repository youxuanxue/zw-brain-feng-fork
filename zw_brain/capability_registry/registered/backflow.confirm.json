{
  "title": "确认回流共享",
  "description": "由供给侧确认回流候选正式纳入模板版本。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "task_id",
      "confirmed"
    ],
    "properties": {
      "task_id": {
        "type": "string",
        "minLength": 1
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "ok",
      "skill_id",
      "audit_id",
      "result"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "skill_id": {
        "type": "string"
      },
      "audit_id": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write",
    "state_machine_transition",
    "task_dispatch",
    "blockchain_anchor"
  ],
  "audit_required": true,
  "idempotency": {
    "key_field": "task_id",
    "ttl_seconds": 300
  },
  "permissions": [
    "backflow.confirm.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "backflow",
    "write",
    "governance"
  ],
  "slug": "backflow.confirm",
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "backflow.confirm"
  },
  "rollback_target": null,
  "product_scope": {
    "journey": "b1",
    "status": "live"
  }
}
