{
  "skill_id": "resource.api.submit_review",
  "slug": "resource.api.submit_review",
  "title": "提交 API 服务审核",
  "description": "把 API 服务资源从草稿推进到待审核。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "resource_code",
      "confirmed"
    ],
    "properties": {
      "resource_code": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string"
      },
      "decision": {
        "type": "string",
        "enum": [
          "approve",
          "return_for_fix"
        ]
      },
      "test_result": {
        "type": "string",
        "enum": [
          "passed",
          "failed"
        ]
      },
      "binding_code": {
        "type": "string"
      },
      "owner_org_id": {
        "type": "string"
      },
      "catalog_code": {
        "type": "string"
      },
      "summary_json": {
        "type": "object"
      },
      "channel_binding": {
        "type": "object"
      },
      "gateway_policy_json": {
        "type": "object"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write",
    "state_machine_transition",
    "blockchain_anchor"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "resource.api.submit_review"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "resource.api.submit_review.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "resource",
    "api",
    "write",
    "governance"
  ]
}
