{
  "skill_id": "application.resource.review",
  "slug": "application.resource.review",
  "title": "审批资源申请",
  "description": "对资源申请执行通过、补正或驳回判定。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "request_id": {
        "type": "string"
      },
      "decision": {
        "type": "string",
        "enum": [
          "approve",
          "approve_reuse",
          "approve_with_supplement",
          "return_for_fix",
          "reject",
          "reject_duplicate",
          "route_to_provider_or_catalog_admin"
        ]
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      },
      "reason": {
        "type": "string"
      },
      "evidence": {
        "type": "object"
      }
    },
    "required": [
      "request_id",
      "decision",
      "confirmed"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "total": {
        "type": "integer"
      },
      "result": {
        "type": "object"
      },
      "ok": {
        "type": "boolean"
      },
      "summary": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write",
    "state_machine_transition",
    "blockchain_anchor"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "application.resource.review"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "application.resource.review.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "application",
    "resource",
    "review",
    "write"
  ]
}
