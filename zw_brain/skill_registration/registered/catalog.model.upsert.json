{
  "skill_id": "catalog.model.upsert",
  "slug": "catalog.model.upsert",
  "title": "维护目录模型",
  "description": "维护 zw-brain 原生目录模型与字段定义，承接目录模板的可审计建模语义。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": ["model_code", "title", "confirmed"],
    "properties": {
      "model_code": { "type": "string", "minLength": 1 },
      "title": { "type": "string" },
      "status": { "type": "string" },
      "owner_org_id": { "type": "string" },
      "model_schema_json": { "type": "object" },
      "fields": { "type": "array", "items": { "type": "object" } },
      "source_ref": { "type": "string" },
      "legacy_object_ref": { "type": "string" },
      "role": { "type": "string" },
      "confirmed": { "type": "boolean" }
    }
  },
  "output_schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "result": { "type": "object" } } },
  "side_effects": ["audit", "db_write", "blockchain_anchor"],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "compatibility": ["webui", "api", "cli", "a2a"],
  "runtime_binding": { "kind": "brain_service", "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill", "method": "catalog.model.upsert" },
  "rollback_target": null,
  "audit_required": true,
  "permissions": ["catalog.model.upsert.execute"],
  "author": { "org": "inspur-cloud", "contact": "zw-brain@inspur.com" },
  "registry_source": "internal",
  "tags": ["catalog", "metadata", "write", "governance"]
}
