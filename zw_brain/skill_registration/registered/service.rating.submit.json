{
  "skill_id": "service.rating.submit",
  "slug": "service.rating.submit",
  "title": "提交服务评价",
  "description": "申请人 在交付完成后为本次共享服务打分（满意度 1-5 + 文字评价），写入审计供 安全审计员 督查。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string"
      },
      "delivery_task_id": {
        "type": "string"
      },
      "score": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "comment": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    },
    "required": [
      "confirmed",
      "score"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "result": {
        "type": "object"
      },
      "ok": {
        "type": "boolean"
      },
      "summary": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-normal",
  "execution_binding": "builtin",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "service.rating.submit"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "service.rating.submit.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "service",
    "rating",
    "write"
  ],
  "product_scope": {
    "journey": "b1",
    "status": "live"
  }
}
