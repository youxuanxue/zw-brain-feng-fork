{
  "skill_id": "assistant.investigation_summary",
  "slug": "assistant.investigation_summary",
  "title": "调查摘要助手",
  "description": "把 B1.1 statistics / anomaly / accountability panel 输出脱敏后送集团推理平台生成调查摘要；不覆盖原始审计证据，只提供阅读辅助。actor/skill_id 在送推理前 hash 化；payload 敏感字段一律脱敏。所有推理调用必须走 shared/inference/client（D6 + D14）。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": ["request_id", "panel"],
    "properties": {
      "request_id": {
        "type": "string",
        "minLength": 1,
        "description": "原 panel 调用 request_id；调推理时强制透传以串审计 trail（D4）"
      },
      "panel": {
        "type": "string",
        "enum": ["statistics", "anomaly", "accountability"],
        "description": "上游 panel 类型"
      },
      "panel_payload": {
        "type": "object",
        "description": "panel 原始输出（statistics buckets / anomaly list / accountability chains 之一）"
      },
      "tenant_id": { "type": "string" },
      "max_tokens": { "type": "integer", "minimum": 64, "maximum": 4096, "default": 800 }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["summary", "model", "sanitized_input_digest"],
    "properties": {
      "summary": { "type": "string" },
      "model": { "type": "string" },
      "sanitized_input_digest": { "type": "string", "description": "SHA1 of sanitized panel payload；可校验脱敏函数稳定性" },
      "usage": { "type": "object" }
    }
  },
  "side_effects": [],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read-sensitive",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": ["webui", "api", "cli", "mcp", "a2a"],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "assistant.investigation_summary"
  },
  "rollback_target": null,
  "audit_required": false,
  "permissions": ["assistant.investigation_summary.execute"],
  "author": { "org": "inspur-cloud", "contact": "zw-brain@inspur.com" },
  "registry_source": "internal",
  "tags": ["audit", "read", "ai-assist", "compliance"],
  "product_scope": { "journey": "b1", "status": "live" }
}
