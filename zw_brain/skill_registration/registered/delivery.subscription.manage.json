{
  "skill_id": "delivery.subscription.manage",
  "slug": "delivery.subscription.manage",
  "title": "管理持续订阅交付",
  "description": "创建、暂停、续期或取消资源订阅关系。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string"
      },
      "subscription_id": {
        "type": "string"
      },
      "action": {
        "type": "string",
        "enum": [
          "create",
          "pause",
          "renew",
          "cancel"
        ]
      },
      "schedule_ref": {
        "type": "object"
      },
      "policy_snapshot": {
        "type": "object"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    },
    "required": [
      "task_id",
      "action",
      "confirmed"
    ]
  },
  "output_schema": {
