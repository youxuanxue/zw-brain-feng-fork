{
  "skill_id": "workbench.view",
  "title": "查看工作台",
  "description": "按角色查看工作台待办、重点提示和副驾摘要。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "role"
    ],
    "properties": {
      "role": {
        "type": "string",
        "enum": [
          "ROLE_ORGAN_OPERATER",
          "ROLE_ORGAN_MANAGER",
          "ROLE_BUSIAUDIT",
          "ROLE_SECURITY_AUDIT"
        ]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "greeting",
      "subtitle",
      "todos",
      "highlights",
      "aiSummary"
    ],
    "properties": {
      "greeting": {
        "type": "string"
      },
      "subtitle": {
        "type": "string"
      },
      "todos": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "highlights": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "aiSummary": {
        "type": "object"
      }
    }
  },
  "side_effects": [],
  "audit_required": true,
  "permissions": [
    "workbench.view.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "workbench",
    "core",
    "golden-path"
  ],
  "slug": "workbench.view",
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read-default",
  "execution_binding": "builtin",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "workbench.view"
  },
  "rollback_target": null
}
