{
  "skill_id": "search.intent.parse",
  "slug": "search.intent.parse",
  "title": "P2 搜索上下文助手（意图解析 + 缺口追问 + 推荐理由）",
  "description": "P2 资源发现页减摩组件。把用户一句话搜索拆成结构化辅助字段：业务意图、关键词、覆盖范围、缺口字段、推荐理由、追问列表。仅作辅助提示，不替代目录树 / 筛选器 / 资源详情。推理走集团推理平台统一通道；推理失败时回落本地规则解析（degraded=true）。可由调用方传 enabled=false 关闭。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "用户一句话搜索语句"
      },
      "role": {
        "type": "string"
      },
      "enabled": {
        "type": "boolean",
        "description": "false 时跳过推理直接走本地规则；默认 true"
      },
      "request_id": {
        "type": "string",
        "description": "审计关联（D4）；缺省由 cap 自动生成"
      }
    },
    "required": [
      "query"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "intent": {
        "type": "string",
        "description": "discover_resource | register_demand | query_application | unknown"
      },
      "keywords": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "dimension": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target_resource_hint": {
            "type": "string"
          },
          "region": {
            "type": "string"
          }
        }
      },
      "missing_fields": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "recommendation_reason": {
        "type": "string"
      },
      "follow_up_questions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "source": {
        "type": "string",
        "description": "inference | fallback_rule"
      },
      "enabled": {
        "type": "boolean"
      },
      "degraded": {
        "type": "boolean",
        "description": "true 表示本次推理失败回落到本地规则"
      }
    }
  },
  "side_effects": [
    "audit"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "search.intent.parse"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "search.intent.parse.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "search",
    "intent",
    "assistant",
    "read"
  ],
  "product_scope": {
    "journey": "j1",
    "status": "live"
  }
}
