{
  "skill_id": "delivery.replace_or_cancel",
  "slug": "delivery.replace_or_cancel",
  "title": "撤回引发的交付替代或取消",
  "description": "审批人 在资源撤回或资产 suspended 时决定：把现有 delivery_task 重新指向替代资源（replace），或者取消并通知订阅方（cancel）。避免授权悬空。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "delivery_code",
      "action",
      "confirmed"
    ],
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      },
      "delivery_code": {
        "type": "string"
      },
      "action": {
        "type": "string",
        "enum": [
          "replace",
          "cancel"
        ]
      },
      "replacement_resource_id": {
        "type": "string"
      },
      "reason": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object"
  },
  "side_effects": [
    "audit",
    "db_write"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "delivery.replace_or_cancel"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "delivery.replace_or_cancel.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "delivery",
    "withdrawal",
    "ROLE_ORGAN_MANAGER",
    "write"
  ],
  "product_scope": {
    "journey": "j1",
    "status": "live"
  }
}
