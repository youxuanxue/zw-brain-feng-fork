{
  "skill_id": "service.publish_or_suspend",
  "slug": "service.publish_or_suspend",
  "title": "发布或暂停供给服务",
  "description": "对供给侧关键服务执行发布或暂停治理动作。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "service_id",
      "action",
      "confirmed"
    ],
    "properties": {
      "service_id": {
        "type": "string",
        "minLength": 1
      },
      "action": {
        "type": "string",
        "enum": [
          "publish",
          "suspend"
        ]
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "ok",
      "skill_id",
      "audit_id",
      "result"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "skill_id": {
        "type": "string"
      },
      "audit_id": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write",
    "state_machine_transition",
    "blockchain_anchor"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "service.publish_or_suspend"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "service.publish_or_suspend.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "provider",
    "service",
    "write",
    "governance"
  ],
  "product_scope": {
    "journey": "b1",
    "status": "live"
  }
}
