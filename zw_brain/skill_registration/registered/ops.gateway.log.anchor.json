{
  "skill_id": "ops.gateway.log.anchor",
  "slug": "ops.gateway.log.anchor",
  "title": "登记网关日志存证",
  "description": "把外部网关日志或旧上链结果登记为本地审计存证请求，异步进入 anchor outbox。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": ["gateway_log_ref", "confirmed"],
    "properties": {
      "gateway_log_ref": { "type": "string", "minLength": 1 },
      "resource_code": { "type": "string" },
      "source_ref": { "type": "string" },
      "evidence_json": { "type": "object" },
      "role": { "type": "string" },
      "confirmed": { "type": "boolean" }
    }
  },
  "output_schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "result": { "type": "object" } } },
  "side_effects": ["audit", "db_write", "blockchain_anchor"],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "compatibility": ["api", "cli", "a2a"],
  "runtime_binding": { "kind": "brain_service", "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill", "method": "ops.gateway.log.anchor" },
  "rollback_target": null,
  "audit_required": true,
  "permissions": ["ops.gateway.log.anchor.execute"],
  "author": { "org": "inspur-cloud", "contact": "zw-brain@inspur.com" },
  "registry_source": "internal",
  "tags": ["ops", "gateway", "audit", "write"]
}
