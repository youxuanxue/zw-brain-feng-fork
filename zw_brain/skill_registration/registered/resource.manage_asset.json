{
  "skill_id": "resource.manage_asset",
  "slug": "resource.manage_asset",
  "title": "治理资源资产",
  "description": "对资源资产执行发布或暂停共享治理动作。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": ["resource_id", "action", "confirmed"],
    "properties": {
      "resource_id": { "type": "string", "minLength": 1 },
      "action": { "type": "string", "enum": ["publish", "suspend"] },
      "role": { "type": "string" },
      "confirmed": { "type": "boolean" }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["ok", "skill_id", "audit_id", "result"],
    "properties": {
      "ok": { "type": "boolean" },
      "skill_id": { "type": "string" },
      "audit_id": { "type": "string" },
      "result": { "type": "object" }
    }
  },
  "side_effects": ["audit", "db_write", "state_machine_transition", "blockchain_anchor"],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "compatibility": ["webui", "api", "cli", "a2a"],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "resource.manage_asset"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": ["resource.manage_asset.execute"],
  "author": { "org": "inspur-cloud", "contact": "zw-brain@inspur.com" },
  "registry_source": "internal",
  "tags": ["resource", "provider", "write", "governance"]
}
