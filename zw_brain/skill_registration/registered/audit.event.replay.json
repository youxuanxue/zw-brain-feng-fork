{
  "skill_id": "audit.event.replay",
  "slug": "audit.event.replay",
  "title": "回放审批链审计事件",
  "description": "按 request_id 拉一条审批链的完整 phase 序列（before / commit / after / error 等），用于安全审计员复现一次写操作的全部审计步骤。事件序列回放，非时间回放；payload 透传给 caller 但 meta-audit 只记录 request_id + count。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "request_id"
    ],
    "properties": {
      "request_id": {
        "type": "string",
        "minLength": 1,
        "description": "审批链 request_id（与 brain.invoke_skill 落审计时的 request_id 一致）"
      },
      "tenant_id": {
        "type": "string",
        "description": "租户 ID；缺省走运行时租户。单租户 sd-default 模式下不可跨租户读"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000,
        "default": 1000
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "request_id",
      "items",
      "summary"
    ],
    "properties": {
      "request_id": { "type": "string" },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "request_id",
            "actor",
            "skill_id",
            "tenant_id",
            "audit_class",
            "event_type",
            "phase",
            "occurred_at",
            "payload"
          ],
          "properties": {
            "request_id": { "type": "string" },
            "actor": { "type": "string" },
            "skill_id": { "type": "string" },
            "tenant_id": { "type": "string" },
            "audit_class": { "type": "string" },
            "event_type": { "type": "string" },
            "phase": { "type": "string" },
            "occurred_at": { "type": "string", "format": "date-time" },
            "payload": { "type": "object" }
          }
        }
      },
      "summary": {
        "type": "object",
        "required": [
          "total",
          "by_audit_class",
          "by_skill",
          "by_actor"
        ],
        "properties": {
          "total": { "type": "integer" },
          "by_audit_class": { "type": "object" },
          "by_skill": { "type": "object" },
          "by_actor": { "type": "object" },
          "first_occurred_at": { "type": [ "string", "null" ] },
          "last_occurred_at": { "type": [ "string", "null" ] }
        }
      }
    }
  },
  "side_effects": [],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read-sensitive",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "audit.event.replay"
  },
  "rollback_target": null,
  "audit_required": false,
  "permissions": [
    "audit.event.replay.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "audit",
    "evidence",
    "read",
    "compliance"
  ],
  "product_scope": {
    "journey": "b1",
    "status": "live"
  }
}
