{
  "skill_id": "platform.docs.read",
  "slug": "platform.docs.read",
  "title": "平台文档全文读取",
  "description": "按相对路径读取 zw-brain 仓库内已授权 Markdown 文档正文（只读，带长度上限），供平台问答 Agent 核对细节。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "文档相对路径，如 deployment/docker-image-deployment.md"
      },
      "rel_path": {
        "type": "string",
        "description": "同 path 的别名"
      },
      "max_chars": {
        "type": "integer",
        "minimum": 500,
        "maximum": 24000
      },
      "role": {
        "type": "string"
      },
      "request_id": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "truncated": {
        "type": "boolean"
      },
      "size_chars": {
        "type": "integer"
      }
    }
  },
  "side_effects": [],
  "audit_required": true,
  "permissions": [
    "platform.docs.read.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "platform-docs",
    "help",
    "read-only"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read-default",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "platform.docs.read"
  },
  "rollback_target": null,
  "product_scope": {
    "journey": "infra",
    "status": "live"
  }
}
