{
  "skill_id": "catalog.duplicate.check",
  "slug": "catalog.duplicate.check",
  "title": "目录重复率检测（发布前）",
  "description": "J2 发布前对单一 catalog 做轻量重复率检测，返回 duplicate_warnings 数组供 P5 提供方管理面 UI 展示（非硬拦：调用方继续执行 publish 即可）。匹配规则：title 完全相等的其他 catalog；同 region_code + 同 owner_org_id 的其他 catalog。不做模糊匹配 / Embedding similarity（属高级匹配，归 R14 三引擎或 ML 阶段）。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "catalog_code": {
        "type": "string"
      },
      "role": {
        "type": "string"
      }
    },
    "required": [
      "catalog_code"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "catalog_code": {
        "type": "string"
      },
      "duplicate_warnings": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "total": {
        "type": "integer"
      }
    }
  },
  "side_effects": [],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read-trace",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "catalog.duplicate.check"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "catalog.duplicate.check.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "catalog",
    "duplicate",
    "publish",
    "warning",
    "read"
  ],
  "product_scope": {
    "journey": "j2",
    "status": "live"
  }
}
