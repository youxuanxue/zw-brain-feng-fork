{
  "skill_id": "application.grant.approve",
  "slug": "application.grant.approve",
  "title": "审批资源授权",
  "description": "审批授权、收回授权或频次变更，审批通过后才能形成授权快照。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string"
      },
      "decision": {
        "type": "string",
        "enum": [
          "approve",
          "revoke",
          "return_for_fix",
          "reject"
        ]
      },
      "grant_policy": {
        "type": "object"
      },
      "reason": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    },
    "required": [
      "task_id",
      "decision",
      "confirmed"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "total": {
        "type": "integer"
      },
      "result": {
        "type": "object"
      },
      "ok": {
        "type": "boolean"
      },
      "summary": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write",
    "state_machine_transition",
    "blockchain_anchor"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "application.grant.approve"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "application.grant.approve.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "application",
    "grant",
    "write"
  ]
}
