{
  "skill_id": "zone.view",
  "title": "查看专区详情",
  "description": "查看单个共享专区或专题包的资产、信任信息和引导说明。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "zone_id"
    ],
    "properties": {
      "zone_id": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "id",
      "name",
      "assets",
      "trust"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "assets": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "trust": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "side_effects": [],
  "audit_required": true,
  "permissions": [
    "zone.view.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "zone",
    "read",
    "frontstage"
  ],
  "slug": "zone.view",
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "read-default",
  "execution_binding": "builtin",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "zone.view"
  },
  "rollback_target": null
}
