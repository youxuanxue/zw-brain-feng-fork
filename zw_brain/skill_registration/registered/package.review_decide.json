{
  "skill_id": "package.review_decide",
  "title": "审核能力包",
  "description": "由管理员对能力注册包执行批准、退回补充或驳回。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "package_id",
      "decision",
      "confirmed"
    ],
    "properties": {
      "package_id": {
        "type": "string",
        "minLength": 1
      },
      "decision": {
        "type": "string",
        "enum": [
          "approve",
          "return_for_fix",
          "reject"
        ]
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "ok",
      "skill_id",
      "audit_id",
      "result"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "skill_id": {
        "type": "string"
      },
      "audit_id": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    }
  },
  "side_effects": [
    "audit",
    "db_write",
    "state_machine_transition",
    "blockchain_anchor"
  ],
  "audit_required": true,
  "idempotency": {
    "key_field": "package_id",
    "ttl_seconds": 300
  },
  "permissions": [
    "package.review_decide.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "package",
    "write",
    "registry"
  ],
  "slug": "package.review_decide",
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": true,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "package.review_decide"
  },
  "rollback_target": null
}
