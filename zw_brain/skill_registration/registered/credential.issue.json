{
  "skill_id": "credential.issue",
  "slug": "credential.issue",
  "title": "签发访问凭据（app_key + secret）",
  "description": "审批通过后为申请签发可使用的 access credential：app_key + app_secret + 有效期 + 调用配额。审批通过路径会自动调用；手工补签由审批人/主管部门触发。",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "request_id": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      },
      "actor_tags": {
        "type": "object"
      },
      "reissue": {
        "type": "boolean",
        "description": "true 强制重新签发（覆盖已有 credential）；默认 false 时若已存在则返回现有"
      }
    },
    "required": [
      "request_id"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "request_id": {
        "type": "string"
      },
      "credential": {
        "type": "object",
        "properties": {
          "app_key": {
            "type": "string"
          },
          "app_secret": {
            "type": "string"
          },
          "valid_from": {
            "type": "string"
          },
          "valid_to": {
            "type": "string"
          },
          "quota_per_day": {
            "type": "integer"
          },
          "invoke_url_template": {
            "type": "string"
          }
        }
      },
      "audit_id": {
        "type": "string"
      },
      "issued_via": {
        "type": "string",
        "description": "auto-on-approval | manual-reissue"
      }
    }
  },
  "side_effects": [
    "audit",
    "credential_issuance",
    "state_machine_transition"
  ],
  "tenant_scope": "tenant",
  "auth_policy": "user",
  "human_confirmation_required": false,
  "audit_class": "write-critical",
  "execution_binding": "builtin",
  "config_change_class": "live",
  "compatibility": [
    "webui",
    "api",
    "cli",
    "a2a"
  ],
  "runtime_binding": {
    "kind": "brain_service",
    "surface_entry": "zw_brain.command.brain.BrainService.invoke_skill",
    "method": "credential.issue"
  },
  "rollback_target": null,
  "audit_required": true,
  "permissions": [
    "credential.issue.execute"
  ],
  "author": {
    "org": "inspur-cloud",
    "contact": "zw-brain@inspur.com"
  },
  "registry_source": "internal",
  "tags": [
    "credential",
    "issue",
    "approval",
    "write"
  ],
  "product_scope": {
    "journey": "j1",
    "status": "live"
  }
}
