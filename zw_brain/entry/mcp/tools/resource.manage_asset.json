{
  "name": "resource.manage_asset",
  "description": "对资源资产执行发布或暂停共享治理动作。",
  "inputSchema": {
    "type": "object",
    "required": [
      "resource_id",
      "action",
      "confirmed"
    ],
    "properties": {
      "resource_id": {
        "type": "string",
        "minLength": 1
      },
      "action": {
        "type": "string",
        "enum": [
          "publish",
          "suspend"
        ]
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "annotations": {
    "mode": "write",
    "humanConfirmationRequired": true,
    "readOnlyHint": false
  },
  "x-zwbrain-side-effects": [
    "audit",
    "db_write",
    "state_machine_transition",
    "blockchain_anchor"
  ],
  "x-zwbrain-permissions": [
    "resource.manage_asset.execute"
  ],
  "x-zwbrain-auth-policy": "user",
  "x-zwbrain-tenant-scope": "tenant"
}
