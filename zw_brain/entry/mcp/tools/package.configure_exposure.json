{
  "name": "package.configure_exposure",
  "description": "在版本登记后显式调整能力包暴露矩阵。",
  "inputSchema": {
    "type": "object",
    "required": [
      "package_id",
      "mode",
      "confirmed"
    ],
    "properties": {
      "package_id": {
        "type": "string",
        "minLength": 1
      },
      "mode": {
        "type": "string",
        "enum": [
          "tighten",
          "expand"
        ]
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "annotations": {
    "mode": "write",
    "humanConfirmationRequired": true,
    "readOnlyHint": false
  },
  "x-zwbrain-side-effects": [
    "audit",
    "db_write",
    "state_machine_transition",
    "blockchain_anchor"
  ],
  "x-zwbrain-permissions": [
    "package.configure_exposure.execute"
  ],
  "x-zwbrain-auth-policy": "user",
  "x-zwbrain-tenant-scope": "tenant"
}
