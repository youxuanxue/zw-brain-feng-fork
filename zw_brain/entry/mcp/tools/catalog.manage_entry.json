{
  "name": "catalog.manage_entry",
  "description": "对目录条目执行发布或说明修正治理动作。",
  "inputSchema": {
    "type": "object",
    "required": [
      "catalog_id",
      "action",
      "confirmed"
    ],
    "properties": {
      "catalog_id": {
        "type": "string",
        "minLength": 1
      },
      "action": {
        "type": "string",
        "enum": [
          "publish",
          "revise"
        ]
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "annotations": {
    "mode": "write",
    "humanConfirmationRequired": true,
    "readOnlyHint": false
  },
  "x-zwbrain-side-effects": [
    "audit",
    "db_write",
    "state_machine_transition",
    "blockchain_anchor"
  ],
  "x-zwbrain-permissions": [
    "catalog.manage_entry.execute"
  ],
  "x-zwbrain-auth-policy": "user",
  "x-zwbrain-tenant-scope": "tenant"
}
