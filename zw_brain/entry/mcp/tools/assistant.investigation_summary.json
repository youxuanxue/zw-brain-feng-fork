{
  "name": "assistant.investigation_summary",
  "description": "把 B1.1 statistics / anomaly / accountability panel 输出脱敏后送集团推理平台生成调查摘要；不覆盖原始审计证据，只提供阅读辅助。actor/skill_id 在送推理前 hash 化；payload 敏感字段一律脱敏。所有推理调用必须走 shared/inference/client（D6 + D14）。",
  "inputSchema": {
    "type": "object",
    "required": [
      "request_id",
      "panel"
    ],
    "properties": {
      "request_id": {
        "type": "string",
        "minLength": 1,
        "description": "原 panel 调用 request_id；调推理时强制透传以串审计 trail（D4）"
      },
      "panel": {
        "type": "string",
        "enum": [
          "statistics",
          "anomaly",
          "accountability"
        ],
        "description": "上游 panel 类型"
      },
      "panel_payload": {
        "type": "object",
        "description": "panel 原始输出（statistics buckets / anomaly list / accountability chains 之一）"
      },
      "tenant_id": {
        "type": "string"
      },
      "max_tokens": {
        "type": "integer",
        "minimum": 64,
        "maximum": 4096,
        "default": 800
      }
    }
  },
  "annotations": {
    "mode": "read",
    "humanConfirmationRequired": false,
    "readOnlyHint": true
  },
  "x-zwbrain-side-effects": [],
  "x-zwbrain-audit-class": "read-sensitive",
  "x-zwbrain-surfaces": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "x-zwbrain-permissions": [
    "assistant.investigation_summary.execute"
  ],
  "x-zwbrain-auth-policy": "user",
  "x-zwbrain-tenant-scope": "tenant"
}
