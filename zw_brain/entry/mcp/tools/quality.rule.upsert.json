{
  "name": "quality.rule.upsert",
  "description": "提供方部门 维护检测规则（必填率/格式/值域/字段一致性/挂接一致性等）。规则按 rule_code 幂等 upsert；变更产生新版本，旧版本检测结论作为历史 evidence 保留。",
  "inputSchema": {
    "type": "object",
    "required": [
      "rule_code",
      "rule_name",
      "rule_kind",
      "confirmed"
    ],
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      },
      "rule_code": {
        "type": "string"
      },
      "rule_name": {
        "type": "string"
      },
      "rule_kind": {
        "type": "string",
        "description": "completeness / format / value-range / consistency / mapping"
      },
      "rule_payload_json": {
        "type": "object"
      },
      "target_catalog_codes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "annotations": {
    "mode": "write",
    "humanConfirmationRequired": true,
    "readOnlyHint": false
  },
  "x-zwbrain-side-effects": [
    "audit",
    "db_write"
  ],
  "x-zwbrain-audit-class": "write-default",
  "x-zwbrain-surfaces": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "x-zwbrain-permissions": [
    "quality.rule.upsert.execute"
  ],
  "x-zwbrain-auth-policy": "user",
  "x-zwbrain-tenant-scope": "tenant"
}
