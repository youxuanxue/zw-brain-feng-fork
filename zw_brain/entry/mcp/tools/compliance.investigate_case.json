{
  "name": "compliance.investigate_case",
  "description": "对合规争议执行推进调查或升级治理动作。",
  "inputSchema": {
    "type": "object",
    "required": [
      "dispute_id",
      "action",
      "confirmed"
    ],
    "properties": {
      "dispute_id": {
        "type": "string",
        "minLength": 1
      },
      "action": {
        "type": "string",
        "enum": [
          "progress",
          "escalate"
        ]
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "annotations": {
    "mode": "write",
    "humanConfirmationRequired": true,
    "readOnlyHint": false
  },
  "x-zwbrain-side-effects": [
    "audit",
    "db_write",
    "state_machine_transition",
    "blockchain_anchor"
  ],
  "x-zwbrain-permissions": [
    "compliance.investigate_case.execute"
  ],
  "x-zwbrain-auth-policy": "user",
  "x-zwbrain-tenant-scope": "tenant"
}
