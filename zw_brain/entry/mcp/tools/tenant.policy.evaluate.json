{
  "name": "tenant.policy.evaluate",
  "description": "基于 brain registry 和租户策略评估指定角色是否可使用能力；旧权限仅作为候选证据。",
  "inputSchema": {
    "type": "object",
    "required": [],
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "capability_id": {
        "type": "string"
      },
      "capability_slug": {
        "type": "string"
      },
      "skill_id": {
        "type": "string"
      },
      "surface": {
        "type": "string",
        "enum": [
          "webui",
          "api",
          "cli",
          "mcp",
          "a2a"
        ]
      },
      "target_ref": {
        "type": "string"
      },
      "role_code": {
        "type": "string"
      },
      "role_codes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "actor_snapshot": {
        "type": "object"
      },
      "org_snapshot": {
        "type": "object"
      },
      "risk_context": {
        "type": "object"
      }
    }
  },
  "annotations": {
    "mode": "read",
    "humanConfirmationRequired": false,
    "readOnlyHint": true
  },
  "x-zwbrain-side-effects": [],
  "x-zwbrain-permissions": [
    "tenant.policy.evaluate.execute"
  ],
  "x-zwbrain-auth-policy": "user",
  "x-zwbrain-tenant-scope": "tenant"
}
