{
  "name": "supplement.submit",
  "description": "由基层提交差异补录结果，进入自动汇总确认。",
  "inputSchema": {
    "type": "object",
    "required": [
      "request_id",
      "confirmed"
    ],
    "properties": {
      "request_id": {
        "type": "string",
        "minLength": 1
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "annotations": {
    "mode": "write",
    "humanConfirmationRequired": true,
    "readOnlyHint": false
  },
  "x-zwbrain-side-effects": [
    "audit",
    "db_write",
    "state_machine_transition",
    "task_dispatch",
    "blockchain_anchor"
  ],
  "x-zwbrain-permissions": [
    "supplement.submit.execute"
  ],
  "x-zwbrain-auth-policy": "user",
  "x-zwbrain-tenant-scope": "tenant"
}
