{
  "name": "backflow.confirm",
  "description": "由供给侧确认回流候选正式纳入模板版本。",
  "inputSchema": {
    "type": "object",
    "required": [
      "task_id",
      "confirmed"
    ],
    "properties": {
      "task_id": {
        "type": "string",
        "minLength": 1
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "annotations": {
    "mode": "write",
    "humanConfirmationRequired": true,
    "readOnlyHint": false
  },
  "x-zwbrain-side-effects": [
    "audit",
    "db_write",
    "state_machine_transition",
    "task_dispatch",
    "blockchain_anchor"
  ],
  "x-zwbrain-permissions": [
    "backflow.confirm.execute"
  ],
  "x-zwbrain-auth-policy": "user",
  "x-zwbrain-tenant-scope": "tenant"
}
