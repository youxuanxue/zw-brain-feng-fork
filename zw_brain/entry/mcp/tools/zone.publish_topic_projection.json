{
  "name": "zone.publish_topic_projection",
  "description": "把已治理资产正式投影到共享专区前台入口。",
  "inputSchema": {
    "type": "object",
    "required": [
      "zone_id",
      "confirmed"
    ],
    "properties": {
      "zone_id": {
        "type": "string",
        "minLength": 1
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "annotations": {
    "mode": "write",
    "humanConfirmationRequired": true,
    "readOnlyHint": false
  },
  "x-zwbrain-side-effects": [
    "audit",
    "db_write",
    "state_machine_transition",
    "blockchain_anchor"
  ],
  "x-zwbrain-permissions": [
    "zone.publish_topic_projection.execute"
  ],
  "x-zwbrain-auth-policy": "user",
  "x-zwbrain-tenant-scope": "tenant"
}
