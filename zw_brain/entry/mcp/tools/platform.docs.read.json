{
  "name": "platform.docs.read",
  "description": "按相对路径读取 zw-brain 仓库内已授权 Markdown 文档正文（只读，带长度上限），供平台问答 Agent 核对细节。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "文档相对路径，如 deployment/docker-image-deployment.md"
      },
      "rel_path": {
        "type": "string",
        "description": "同 path 的别名"
      },
      "max_chars": {
        "type": "integer",
        "minimum": 500,
        "maximum": 24000
      },
      "role": {
        "type": "string"
      },
      "request_id": {
        "type": "string"
      }
    }
  },
  "annotations": {
    "mode": "read",
    "humanConfirmationRequired": false,
    "readOnlyHint": true
  },
  "x-zwbrain-side-effects": [],
  "x-zwbrain-audit-class": "read-default",
  "x-zwbrain-surfaces": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "x-zwbrain-permissions": [
    "platform.docs.read.execute"
  ],
  "x-zwbrain-auth-policy": "user",
  "x-zwbrain-tenant-scope": "tenant"
}
