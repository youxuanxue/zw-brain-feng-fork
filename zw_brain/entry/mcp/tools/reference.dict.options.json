{
  "name": "reference.dict.options",
  "description": "表单枚举字段下拉读取字典参照（pub_dict KIND 分组，如 organLine / data_sensity_level）：传 dict_type 取该分组下 code↔name 选项。只读，不写库。",
  "inputSchema": {
    "type": "object",
    "required": [
      "dict_type"
    ],
    "properties": {
      "dict_type": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "annotations": {
    "mode": "read",
    "humanConfirmationRequired": false,
    "readOnlyHint": true
  },
  "x-zwbrain-side-effects": [],
  "x-zwbrain-audit-class": "read-default",
  "x-zwbrain-surfaces": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "x-zwbrain-permissions": [
    "reference.dict.options.execute"
  ],
  "x-zwbrain-auth-policy": "user",
  "x-zwbrain-tenant-scope": "tenant"
}
