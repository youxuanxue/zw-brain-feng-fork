{
  "name": "request.create",
  "description": "从资源发现页基于已识别模板发起新的受控准入申请。",
  "inputSchema": {
    "type": "object",
    "required": [
      "resource_id",
      "confirmed"
    ],
    "properties": {
      "resource_id": {
        "type": "string",
        "minLength": 1
      },
      "query": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      }
    }
  },
  "annotations": {
    "mode": "write",
    "humanConfirmationRequired": true,
    "readOnlyHint": false
  },
  "x-zwbrain-side-effects": [
    "audit",
    "db_write",
    "state_machine_transition",
    "task_dispatch",
    "blockchain_anchor"
  ],
  "x-zwbrain-permissions": [
    "request.create.execute"
  ],
  "x-zwbrain-auth-policy": "user",
  "x-zwbrain-tenant-scope": "tenant"
}
