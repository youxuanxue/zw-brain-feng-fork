{
  "name": "catalog.entry.query",
  "description": "查询已进入 canonical 聚合的目录条目详情和列表。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      },
      "catalog_code": {
        "type": "string"
      },
      "source": {
        "type": "string",
        "description": "filter by summary_json.source (e.g. 'reverse' for 反向编目 drafts)"
      },
      "lifecycle_status": {
        "type": "string",
        "description": "filter by lifecycle_status (draft / pending_review / active / ...)"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "description": "max rows to return; filters apply in SQL before serialization"
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "description": "skip rows before applying limit"
      },
      "order": {
        "type": "string",
        "enum": [
          "updated_desc"
        ],
        "description": "result ordering: 'updated_desc' = newest updated first (work-queue view); default = catalog_code ascending (stable browse order)"
      },
      "role": {
        "type": "string"
      }
    }
  },
  "annotations": {
    "mode": "read",
    "humanConfirmationRequired": false,
    "readOnlyHint": true
  },
  "x-zwbrain-side-effects": [],
  "x-zwbrain-audit-class": "read-trace",
  "x-zwbrain-surfaces": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "x-zwbrain-permissions": [
    "catalog.entry.query.execute"
  ],
  "x-zwbrain-auth-policy": "user",
  "x-zwbrain-tenant-scope": "tenant"
}
