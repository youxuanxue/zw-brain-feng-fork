{
  "name": "catalog.entry.reverse_draft.confirm",
  "description": "部门管理员 部门审通过反向编目草稿（D57⑧ 两级管线第一级）：随部门审落字段口径裁决（中英文/敏感等级/类型）。通过后 catalog_entry.lifecycle_status 从 draft 推进到 pending_platform_review，汇入正向目录审核平台档由 业务运营员 复核。 [Requires user confirmation]",
  "inputSchema": {
    "type": "object",
    "required": [
      "catalog_code",
      "confirmed"
    ],
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      },
      "catalog_code": {
        "type": "string"
      },
      "field_decisions": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "comment": {
        "type": "string"
      }
    }
  },
  "annotations": {
    "mode": "write",
    "humanConfirmationRequired": true,
    "readOnlyHint": false
  },
  "x-zwbrain-side-effects": [
    "audit",
    "db_write"
  ],
  "x-zwbrain-audit-class": "write-critical",
  "x-zwbrain-surfaces": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "x-zwbrain-permissions": [
    "catalog.entry.reverse_draft.confirm.execute"
  ],
  "x-zwbrain-auth-policy": "user",
  "x-zwbrain-tenant-scope": "tenant"
}
