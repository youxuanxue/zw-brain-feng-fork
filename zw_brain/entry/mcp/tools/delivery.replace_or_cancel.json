{
  "name": "delivery.replace_or_cancel",
  "description": "审批人 在资源撤回或资产 suspended 时决定：把现有 delivery_task 重新指向替代资源（replace），或者取消并通知订阅方（cancel）。避免授权悬空。 [Requires user confirmation]",
  "inputSchema": {
    "type": "object",
    "required": [
      "delivery_code",
      "action",
      "confirmed"
    ],
    "properties": {
      "tenant_id": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean"
      },
      "delivery_code": {
        "type": "string"
      },
      "action": {
        "type": "string",
        "enum": [
          "replace",
          "cancel"
        ]
      },
      "replacement_resource_id": {
        "type": "string"
      },
      "reason": {
        "type": "string"
      }
    }
  },
  "annotations": {
    "mode": "write",
    "humanConfirmationRequired": true,
    "readOnlyHint": false
  },
  "x-zwbrain-side-effects": [
    "audit",
    "db_write"
  ],
  "x-zwbrain-audit-class": "write-critical",
  "x-zwbrain-surfaces": [
    "webui",
    "api",
    "cli",
    "mcp",
    "a2a"
  ],
  "x-zwbrain-permissions": [
    "delivery.replace_or_cancel.execute"
  ],
  "x-zwbrain-auth-policy": "user",
  "x-zwbrain-tenant-scope": "tenant"
}
